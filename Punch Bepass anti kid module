return function(API)
    local C = API.Config
    local S = API.State
    local Players = API.Players
    local RunService = API.RunService
    local LP = API.LP

    local M = {
        Enabled = true,
        Task = "Idle",
        LastTaskChange = 0,
        LastPos = nil,
        StuckTimer = 0,
        StuckAttempts = 0,
        LastJump = 0,
        LastAttack = 0,
        LastAbility = 0,
        LastSprintState = false,
        LastHeal = 0,
        LastLootTouch = 0,
        CurrentLoot = nil,
        CurrentTarget = nil,
        CombatEnterDist = 40,
        CombatExitDist = 60,
        LootSearchRadius = 600,
        HealThreshold = 0.35,
        AttackDistMelee = 8,
        AttackDistGun = 15,
        AttackDistBear = 10,
        SprintDist = 15,
        TickRate = 0.1,
    }

    local function now() return os.clock() end
    local function setTask(t)
        if M.Task ~= t then
            M.Task = t
            M.LastTaskChange = now()
            if API.setTask then API.setTask(t) end
        end
    end

    local function getHP()
        local hum = API.getHum()
        if not hum then return 1 end
        return hum.Health / math.max(hum.MaxHealth, 1)
    end

    local function isBear()
        local char = API.getChar()
        return char and API.isPlayerBear(char) or false
    end

    local function nearestThreat()
        local root = API.getRoot()
        if not root then return nil, math.huge end
        local bears = workspace:FindFirstChild("Bears")
        if not bears then return nil, math.huge end
        local best, bestDist = nil, math.huge
        for _, m in ipairs(bears:GetChildren()) do
            if m:IsA("Model") and API.isAlive(m) then
                local part = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head")
                if part then
                    local d = (part.Position - root.Position).Magnitude
                    if d < bestDist then bestDist = d; best = m end
                end
            end
        end
        return best, bestDist
    end

    local function nearestLoot()
        local root = API.getRoot()
        if not root then return nil, math.huge end
        local best, bestDist = nil, M.LootSearchRadius
        if C.FarmPages then
            local pages = workspace:FindFirstChild("Pages")
            if pages then
                for _, obj in ipairs(pages:GetChildren()) do
                    if obj:IsA("BasePart") then
                        local d = (obj.Position - root.Position).Magnitude
                        if d < bestDist then bestDist = d; best = obj end
                    end
                end
            end
        end
        if C.FarmCrates then
            local interactables = workspace:FindFirstChild("Interactables")
            local crates = interactables and interactables:FindFirstChild("Crates")
            if crates then
                for _, obj in ipairs(crates:GetChildren()) do
                    local part = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
                    if part then
                        local d = (part.Position - root.Position).Magnitude
                        if d < bestDist then bestDist = d; best = part end
                    end
                end
            end
        end
        return best, bestDist
    end

    local function equipBestTool()
        local char = API.getChar()
        if not char then return nil end
        local tool = char:FindFirstChildWhichIsA("Tool")
        if tool then return tool end
        local backpack = LP:FindFirstChild("Backpack")
        if not backpack then return nil end
        local hum = API.getHum()
        if not hum then return nil end
        local best = nil
        for _, t in ipairs(backpack:GetChildren()) do
            if t:IsA("Tool") then
                local name = t.Name
                if name == "Medkit" or name == "Hearthstone" or name == "Flare" then
                else
                    best = t
                    break
                end
            end
        end
        if best then
            pcall(function() hum:EquipTool(best) end)
            return best
        end
        return nil
    end

    local function sprint(on)
        if M.LastSprintState == on then return end
        M.LastSprintState = on
        if isBear() then
            API.setBearSprint(on)
        end
    end

    local function checkStuck()
        local root = API.getRoot()
        if not root then return end
        local pos = root.Position
        if M.LastPos then
            local moved = (pos - M.LastPos).Magnitude
            if moved < 1 then
                M.StuckTimer = M.StuckTimer + M.TickRate
            else
                M.StuckTimer = 0
                M.StuckAttempts = 0
            end
        end
        M.LastPos = pos
        if M.StuckTimer > 1.5 then
            local hum = API.getHum()
            if hum and now() - M.LastJump > 0.5 then
                M.LastJump = now()
                hum.Jump = true
                M.StuckAttempts = M.StuckAttempts + 1
                if M.StuckAttempts >= 3 then
                    API.clearPath()
                    M.StuckAttempts = 0
                end
            end
            M.StuckTimer = 0
        end
    end

    local function doHeal()
        local hum = API.getHum()
        if not hum or not API.MedkitRemote then return false end
        if now() - M.LastHeal < 2 then return true end
        local backpack = LP:FindFirstChild("Backpack")
        local medkit = backpack and backpack:FindFirstChild("Medkit")
        if not medkit then return false end
        local root = API.getRoot()
        local threat, dist = nearestThreat()
        if threat and dist < 20 then
            if root and threat:FindFirstChild("HumanoidRootPart") then
                local away = (root.Position - threat.HumanoidRootPart.Position).Unit
                API.moveTo(root.Position + away * 30)
                sprint(true)
            end
            return true
        end
        M.LastHeal = now()
        pcall(function()
            hum:EquipTool(medkit)
            task.wait(0.2)
            API.MedkitRemote:FireServer("Start")
        end)
        return true
    end

    local function doRetreat()
        local root = API.getRoot()
        if not root then return end
        local threat = nearestThreat()
        local dir
        if threat and threat:FindFirstChild("HumanoidRootPart") then
            dir = root.Position - threat.HumanoidRootPart.Position
        else
            dir = -root.CFrame.LookVector
        end
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
        dir = dir.Unit
        API.moveTo(root.Position + dir * 40)
        sprint(true)
    end

    local function doCombat()
        local threat, dist = nearestThreat()
        if not threat then return false end
        local root = API.getRoot()
        if not root then return false end
        local targetPart = threat:FindFirstChild("HumanoidRootPart") or threat:FindFirstChild("Head")
        if not targetPart then return false end

        if isBear() then
            if dist > M.AttackDistBear then
                API.moveTo(targetPart.Position)
                sprint(true)
            else
                sprint(false)
                local hum = API.getHum()
                if hum then
                    local look = Vector3.new(targetPart.Position.X, root.Position.Y, targetPart.Position.Z)
                    pcall(function() root.CFrame = CFrame.new(root.Position, look) end)
                end
                if now() - M.LastAbility > 0.6 then
                    M.LastAbility = now()
                    API.useBearAbility(nil)
                end
                if now() - M.LastAttack > 0.5 then
                    M.LastAttack = now()
                    API.useBearAbility("Default")
                end
            end
        else
            equipBestTool()
            local tool = API.getEquippedTool()
            if not tool then return false end
            local remoteName = tool.Name
            local isGun = remoteName ~= "FireBrand" and remoteName ~= "Knife" and remoteName ~= "FireAxe" and remoteName ~= "BaseballBat" and remoteName ~= "Pickaxe"
            local atkDist = isGun and M.AttackDistGun or M.AttackDistMelee
            if dist > atkDist then
                API.moveTo(targetPart.Position)
                sprint(true)
            else
                sprint(false)
                local hum = API.getHum()
                if hum then
                    local look = Vector3.new(targetPart.Position.X, root.Position.Y, targetPart.Position.Z)
                    pcall(function() root.CFrame = CFrame.new(root.Position, look) end)
                end
                if isGun then
                    if now() - M.LastAttack > C.GunCooldown then
                        M.LastAttack = now()
                        pcall(API.fireNearestGun)
                    end
                else
                    if now() - M.LastAttack > C.MeleeCooldown then
                        M.LastAttack = now()
                        pcall(API.hitNearestMelee)
                    end
                end
            end
        end
        return true
    end

    local function doLoot()
        local loot, dist = nearestLoot()
        if not loot then return false end
        local root = API.getRoot()
        if not root then return false end
        if dist > 10 then
            API.moveTo(loot.Position)
            sprint(true)
            return true
        end
        sprint(false)
        if now() - M.LastLootTouch > 0.3 then
            M.LastLootTouch = now()
            pcall(API.touchLoot, loot)
        end
        return true
    end

    local function tick()
        if not M.Enabled then return end
        if not C.BotEnabled then setTask("Idle"); return end
        local char = API.getChar()
        local root = API.getRoot()
        if not char or not root then setTask("Idle"); return end

        checkStuck()

        local hp = getHP()
        local threat, dist = nearestThreat()
        local loot, lootDist = nearestLoot()

        local backpack = LP:FindFirstChild("Backpack")
        local hasMedkit = backpack and backpack:FindFirstChild("Medkit") ~= nil

        if hp < M.HealThreshold then
            if hasMedkit and doHeal() then setTask("Heal"); return end
            setTask("Retreat"); doRetreat(); return
        end

        local inCombat = M.Task == "Combat"
        local shouldCombat = false
        if threat then
            if inCombat and dist <= M.CombatExitDist then shouldCombat = true
            elseif dist <= M.CombatEnterDist then shouldCombat = true end
        end

        if shouldCombat then
            setTask("Combat")
            if doCombat() then return end
        end

        if loot then
            setTask("Loot")
            if doLoot() then return end
        end

        if threat and dist <= M.CombatEnterDist then
            setTask("Combat")
            if doCombat() then return end
        end

        setTask("Idle")
        sprint(false)
        if isBear() and C.BearForceAggressive and API.BearStance then
            local stance = API.BearStance.Get(char)
            if stance == API.BearStance.FRIENDLY and not API.BearStance.Switching(char) and not API.BearStance.Locked(char) then
                pcall(function() API.BearAbilityRemote:FireServer("Stance") end)
            end
        end
    end

    local conn
    local function start()
        if conn then return end
        conn = task.spawn(function()
            while M.Enabled do
                task.wait(M.TickRate)
                pcall(tick)
            end
            conn = nil
        end)
    end

    local function stop()
        M.Enabled = false
        if conn then task.cancel(conn); conn = nil end
        pcall(API.clearPath)
        sprint(false)
    end

    API.ModuleSelf = M
    API.ModuleStop = stop

    start()

    return {
        Tick = tick,
        Stop = stop,
        State = M,
        Task = function() return M.Task end,
    }
end
