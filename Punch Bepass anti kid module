return function(API)
    local C = API.Config
    local S = API.State
    local LP = API.LP

    local M = {
        Task = "Idle",
        LastAttack = 0, LastM1 = 0, LastSlot = 0, LastStanceSwitch = 0,
        LastHeal = 0, LastLootTouch = 0,
        LastPos = nil, StuckTime = 0, LastJump = 0,
        EnterDist = 40, ExitDist = 60,
    }

    local function now() return os.clock() end
    local function setTask(t)
        if M.Task ~= t then M.Task = t; API.setTask(t) end
    end
    local function getHP()
        local h = API.getHum(); if not h then return 1 end
        return h.Health / math.max(h.MaxHealth, 1)
    end
    local function isBearRole()
        local c = API.getChar(); return c and API.isPlayerBear(c) or false
    end

    local function nearestEnemyBear()
        local root = API.getRoot(); if not root then return nil, math.huge end
        local bears = workspace:FindFirstChild("Bears"); if not bears then return nil, math.huge end
        local best, bestDist = nil, math.huge
        for _, m in ipairs(bears:GetChildren()) do
            if m:IsA("Model") and API.isAlive(m) and m ~= API.getChar() then
                local p = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head")
                if p then
                    local d = (p.Position - root.Position).Magnitude
                    if d < bestDist then bestDist = d; best = m end
                end
            end
        end
        return best, bestDist
    end

    local function hasMedkit()
        local bp = LP:FindFirstChild("Backpack")
        return bp and bp:FindFirstChild("Medkit") ~= nil
    end

    local function useMedkit()
        if not API.MedkitRemote then return false end
        local t = now()
        if t - M.LastHeal < 3 then return false end
        M.LastHeal = t
        local hum = API.getHum()
        local bp = LP:FindFirstChild("Backpack")
        local med = bp and bp:FindFirstChild("Medkit")
        if not med or not hum then return false end
        pcall(function()
            hum:EquipTool(med)
            task.wait(0.15)
            API.MedkitRemote:FireServer("Start")
        end)
        return true
    end

    local function retreatFrom(target)
        local root = API.getRoot(); if not root then return end
        local tp = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Head")
        if not tp then return end
        local d = root.Position - tp.Position
        d = Vector3.new(d.X, 0, d.Z)
        if d.Magnitude < 0.1 then d = Vector3.new(1, 0, 0) end
        d = d.Unit
        API.moveTo(root.Position + d * 40)
        API.setBearSprint(true)
    end

    local function gotoLoot(loot, dist)
        if not loot then return end
        if dist > 8 then API.moveTo(loot.Position); API.setBearSprint(true); return end
        API.setBearSprint(false)
        local hum = API.getHum()
        if hum then pcall(function() hum:MoveTo(loot.Position) end) end
        if now() - M.LastLootTouch > 0.3 then
            M.LastLootTouch = now()
            pcall(API.touchLoot, loot)
        end
    end

    local function stopMoving()
        API.setBearSprint(false)
        local hum = API.getHum(); local root = API.getRoot()
        if hum and root then pcall(function() hum:MoveTo(root.Position) end) end
    end

    local function equipBestWeapon()
        local hum = API.getHum(); if not hum then return nil end
        local bp = LP:FindFirstChild("Backpack"); if not bp then return nil end
        local priority = {
            GoldenGun=true, AK47=true, Minigun=true, GoldenMinigun=true,
            CombatShotgun=true, Shotgun=true, SMG=true, Flamethrower=true,
            OldRifle=true, Pistol=true, FireBrand=true, FireAxe=true,
            BaseballBat=true, Knife=true, Pickaxe=true,
        }
        local pick = nil
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and priority[t.Name] then pick = t; break end
        end
        if not pick then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and t.Name ~= "Medkit" and t.Name ~= "Hearthstone" and t.Name ~= "Flare" then
                    pick = t; break
                end
            end
        end
        if pick then pcall(function() hum:EquipTool(pick) end); return pick end
        return nil
    end

    local function combat(target, dist, bear)
        local root = API.getRoot(); local hum = API.getHum()
        if not root or not hum then return end
        local tp = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Head")
        if not tp then return end
        local look = Vector3.new(tp.Position.X, root.Position.Y, tp.Position.Z)
        if (look - root.Position).Magnitude > 0.1 then
            pcall(function() root.CFrame = CFrame.new(root.Position, look) end)
        end
        if bear then
            if dist > 10 then API.moveTo(tp.Position); API.setBearSprint(true)
            else
                API.setBearSprint(false)
                local t = now()
                if t - M.LastM1 > 1.05 then
                    M.LastM1 = t
                    pcall(function() API.BearAbilityRemote:FireServer("Use", "Default", tp.Position) end)
                end
                if t - M.LastSlot > 1.05 then
                    M.LastSlot = t
                    local slot = math.random(1, 6)
                    pcall(function() API.BearAbilityRemote:FireServer("Use", slot, tp.Position) end)
                end
            end
        else
            local tool = API.getEquippedTool()
            if not tool then tool = equipBestWeapon() end
            if not tool then return end
            local isGun = API.getWeaponRemote(tool, "FireBullet") ~= nil
            local isMelee = API.getWeaponRemote(tool, "MeleeRemote") ~= nil
            local range = isGun and C.GunRange or C.MeleeRange
            if dist > range then API.moveTo(tp.Position); API.setBearSprint(true)
            else
                stopMoving()
                local t = now()
                if isGun and t - M.LastAttack > C.GunCooldown then
                    M.LastAttack = t; pcall(API.fireNearestGun)
                elseif isMelee and t - M.LastAttack > C.MeleeCooldown then
                    M.LastAttack = t; pcall(API.hitNearestMelee)
                end
            end
        end
    end

    local function checkStuck()
        local root = API.getRoot(); if not root then return end
        if M.LastPos then
            if (root.Position - M.LastPos).Magnitude < 1 then M.StuckTime = M.StuckTime + 0.1
            else M.StuckTime = 0 end
        end
        M.LastPos = root.Position
        if M.StuckTime > 1.5 then
            local hum = API.getHum()
            if hum and now() - M.LastJump > 0.5 then
                M.LastJump = now(); hum.Jump = true; API.clearPath()
            end
            M.StuckTime = 0
        end
    end

    local function tick()
        if not C.BotEnabled then setTask("Idle"); return end
        local char = API.getChar(); local root = API.getRoot(); local hum = API.getHum()
        if not char or not root or not hum then setTask("Idle"); return end
        checkStuck()
        local bear = isBearRole()
        local hp = getHP()

        if hp < C.BotRetreatHP then
            local threat, tdist = nearestEnemyBear()
            if threat and tdist < 20 then setTask("Retreat"); retreatFrom(threat); return end
            if hasMedkit() then setTask("Heal"); if useMedkit() then return end end
        end

        local bearTarget, bearDist = nearestEnemyBear()
        local inCombat = M.Task == "Combat"
        local shouldCombat = bearTarget and ((inCombat and bearDist <= M.ExitDist) or bearDist <= M.EnterDist)
        if shouldCombat then setTask("Combat"); combat(bearTarget, bearDist, bear); return end

        local loot, lootDist = API.findNearestLoot()
        if loot then setTask("Loot"); gotoLoot(loot, lootDist or math.huge); return end

        if bearTarget then setTask("Combat"); combat(bearTarget, bearDist, bear); return end

        setTask("Idle"); stopMoving()
        if bear and C.BearForceAggressive and API.BearAbilityRemote then
            local now2 = workspace:GetServerTimeNow()
            local switchEnds = char:GetAttribute("StanceSwitchEnds")
            local switching = type(switchEnds) == "number" and switchEnds > now2
            local stance = char:GetAttribute("Stance")
            if stance == "Friendly" and not switching and now() - M.LastStanceSwitch > 3 then
                M.LastStanceSwitch = now()
                pcall(function() API.BearAbilityRemote:FireServer("Stance") end)
            end
        end
    end

    return { Tick = tick, State = M, Task = function() return M.Task end }
end
