local function IsAttackingUs(model)
    if not model then return false end
    local rp = model:FindFirstChild("HumanoidRootPart")
    if not rp or not root then return false end
    local tool = model:FindFirstChildOfClass("Tool")
    if not tool then return false end
    local d = (rp.Position - root.Position).Magnitude
    if d > 15 then return false end
    local toUs = (root.Position - rp.Position)
    if toUs.Magnitude < 0.01 then return true end
    local dot = rp.CFrame.LookVector:Dot(toUs.Unit)
    return dot > 0.5
end

local function ScoreTarget(model, r)
    if not model or not r then return -math.huge end
    local h = model:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return -math.huge end

    local dist = (r.Position - root.Position).Magnitude
    if dist > Radius or dist > MaxTargetDistance then return -math.huge end

    local isPlayerChar = IsPlayerCharacter(model)

    if PassivePlayersMode and isPlayerChar then
        if PassiveRetaliate then
            if not IsHostilePlayer(model) and not IsAttackingUs(model) then
                return -math.huge
            end
        else
            return -math.huge
        end
    end

    if AttackersOnlyMode and not IsAttackingUs(model) and not IsHostilePlayer(model) then
        return -math.huge
    end

    if PreferClosestMode or not UseSmartTarget then
        return 10000 - dist
    end

    local score = 0
    score = score + (1000 - dist) * WeightDistance

    if isPlayerChar then
        score = score + WeightPlayer
    else
        score = score + WeightNPC
    end

    local hpRatio = h.Health / math.max(h.MaxHealth, 1)
    score = score + (1 - hpRatio) * WeightLowHP

    if hpRatio < 0.5 then
        score = score + WeightAlreadyHurt
    end

    if model == LastAttacker and tick() - LastAttackerTime < 5 then
        score = score + WeightAttacker
    end

    if IsHostilePlayer(model) then
        score = score + WeightAttacker
    end

    local toUs = (root.Position - r.Position)
    if toUs.Magnitude > 0.01 then
        toUs = toUs.Unit
        local facing = r.CFrame.LookVector
        if facing:Dot(toUs) < -0.3 then
            score = score + WeightBackTurned
        end
    end

    if model:FindFirstChildOfClass("Tool") then
        score = score + WeightArmed
    end

    if IsAttackingUs(model) then
        score = score + WeightThreatToMe
    end

    return score
end

local function GetTarget()
    if not character or not root then return nil end

    local best, bestScore = nil, -math.huge

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and IsAlive(p.Character) then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r then
                local sc = ScoreTarget(p.Character, r)
                if sc > bestScore then bestScore = sc; best = p.Character end
            end
        end
    end

    UpdateNPCCache()
    for npc, r in pairs(NPCCache) do
        if r and r.Parent and IsAlive(npc) then
            local sc = ScoreTarget(npc, r)
            if sc > bestScore then bestScore = sc; best = npc end
        end
    end

    return best
end

local function GetEnemyHitboxSize(target)
