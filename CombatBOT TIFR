local function PredictTargetPosition(target)
    local r = target:FindFirstChild("HumanoidRootPart")
    if not r then return nil, 0 end

    local now = tick()
    local pingComp = GetCombinedPing()

    table.insert(targetHistory, {pos = r.Position, time = now})
    while #targetHistory > 12 or (#targetHistory > 0 and now - targetHistory[1].time > 0.5) do
        table.remove(targetHistory, 1)
    end

    if #targetHistory < 3 then
        return r.Position, 0
    end

    local oldest = targetHistory[1]
    local newest = targetHistory[#targetHistory]
    local dt = newest.time - oldest.time
    if dt < 0.02 then return r.Position, 0 end

    local avgVel = (newest.pos - oldest.pos) / dt

    local accel = Vector3.zero
    if #targetHistory >= 3 then
        local a = targetHistory[#targetHistory - 2]
        local b = targetHistory[#targetHistory - 1]
        local c = targetHistory[#targetHistory]
        local v1 = (b.pos - a.pos) / math.max(b.time - a.time, 0.001)
        local v2 = (c.pos - b.pos) / math.max(c.time - b.time, 0.001)
        accel = (v2 - v1) / math.max(c.time - a.time, 0.001)
    end

    local t = pingComp * PredictPingFactor + PredictBaseTime
    local predicted = r.Position
        + avgVel * t * PredictVelocityFactor
        + accel * (t * t) * PredictAccelFactor

    if UseAntiAir then
        local th = target:FindFirstChildOfClass("Humanoid")
        if th and th.FloorMaterial == Enum.Material.Air then
            local g = workspace.Gravity
            local yOff = avgVel.Y * t - 0.5 * g * t * t
            predicted = Vector3.new(predicted.X, r.Position.Y + yOff, predicted.Z)
        end
    end

    local offset = predicted - r.Position
    if offset.Magnitude > PredictMaxDistance then
        predicted = r.Position + offset.Unit * PredictMaxDistance
    end

    return predicted, avgVel.Magnitude
end

local function ResetPath()
    currentPath = nil
    currentWaypoints = {}
    currentWaypointIndex = 1
    lastPathTarget = nil
end

local function ComputePath(startPos, targetPos)
    if not UsePathfinding then return nil end

    local now = tick()
    if now - lastPathCompute < pathRecomputeInterval and currentPath then
        return currentWaypoints, currentWaypointIndex
    end
    if lastPathTarget and (targetPos - lastPathTarget).Magnitude < 6 and currentPath then
        return currentWaypoints, currentWaypointIndex
    end

    lastPathCompute = now
    lastPathTarget = targetPos

    local path = PathService:CreatePath({
        AgentRadius = 2.5,
        AgentHeight = 5.5,
        AgentCanJump = true,
        AgentCanClimb = false,
        WaypointSpacing = 5,
        Costs = { Water = 30 }
    })

    local ok = pcall(function() path:ComputeAsync(startPos, targetPos) end)
    if ok and path.Status == Enum.PathStatus.Success then
        currentPath = path
        currentWaypoints = path:GetWaypoints()
        currentWaypointIndex = 2
        return currentWaypoints, currentWaypointIndex
    end
    currentPath = nil
    return nil
end

local function SmoothMoveTo(hum, targetPos)
    if not hum then return end
    if not currentMoveTarget then
        currentMoveTarget = targetPos
        moveAlpha = 0
    end
    moveAlpha = math.min(moveAlpha + 0.05, 1)
    currentMoveTarget = currentMoveTarget:Lerp(targetPos, moveAlpha)
    hum:MoveTo(currentMoveTarget)
end

local function FollowPath(hum, rootPart)
    if not currentPath or #currentWaypoints == 0 then return false end
    if currentPath.Status ~= Enum.PathStatus.Success then return false end

    local wp = currentWaypoints[currentWaypointIndex]
    if not wp then return false end

    if wp.Action == Enum.PathWaypointAction.Jump then
        hum.Jump = true
    end

    local flatDist = (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) -
                      Vector3.new(wp.Position.X, 0, wp.Position.Z)).Magnitude
    if flatDist < 4 then
        currentWaypointIndex = currentWaypointIndex + 1
        if currentWaypointIndex > #currentWaypoints then
            return false
        end
    end

    SmoothMoveTo(hum, wp.Position)
    return true
end

local function CheckIfStuck()
    if not root or not humanoid then return false end
    local now = tick()
    local dt = now - lastStuckCheck
    lastStuckCheck = now
    if dt > 0.5 then dt = 0.016 end

    if humanoid.MoveDirection.Magnitude < 0.1 then
        stuckTimer = stuckTimer + dt
        if stuckTimer > 1.5 then return true end
        return false
    end

    table.insert(stuckPositions, root.Position)
    if #stuckPositions > 20 then table.remove(stuckPositions, 1) end
    if #stuckPositions < 15 then return false end

    local dist = (stuckPositions[#stuckPositions] - stuckPositions[1]).Magnitude
    if dist < 3 then
        stuckTimer = stuckTimer + dt
        if stuckTimer > 1.0 then return true end
    else
        stuckTimer = 0
        stuckAttempts = 0
    end
    return false
end

local function Unstuck()
    if not root or not humanoid then return end
    ResetPath()
    stuckAttempts = stuckAttempts + 1
    if stuckAttempts <= 2 then
        humanoid.Jump = true
        task.wait(0.1)
        local ang = math.random(-60, 60)
        local dir = Vector3.new(math.sin(math.rad(ang)), 0, math.cos(math.rad(ang)))
        if dir.Magnitude > 0.1 then
            dir = dir.Unit
            humanoid:MoveTo(root.Position + dir * 15)
            stuckDirection = dir
        end
    elseif stuckAttempts <= 4 then
        local right = stuckDirection:Cross(Vector3.new(0, 1, 0))
        if right.Magnitude > 0.1 then
            right = right.Unit
            local side = (stuckAttempts % 2 == 0) and right or -right
            humanoid:MoveTo(root.Position + side * 20)
            humanoid.Jump = true
        end
    else
        humanoid:MoveTo(root.Position - stuckDirection * 25)
        humanoid.Jump = true
        stuckAttempts = 0
    end
    stuckPositions = {}
    stuckTimer = 0
end

local enemyToolConns = {}

local function PredictEnemyAttackLanding(enemyChar)
    local erp = enemyChar:FindFirstChild("HumanoidRootPart")
    if not erp or not root then return nil end
    local dir = (root.Position - erp.Position)
    if dir.Magnitude < 0.01 then return nil end
    dir = dir.Unit
    local dist = (root.Position - erp.Position).Magnitude
    local pingComp = GetCombinedPing()
    local enemyVel = erp.AssemblyLinearVelocity or Vector3.zero
    local proj = dir * dist + enemyVel * (pingComp + DodgeReaction)
    return erp.Position + proj
end

local function OnEnemyAttack(enemyChar)
    if not UseDodge then return end
    if not character or not root or not humanoid then return end
    if tick() - dodgeLastTrigger < DodgeCooldown then return end

    MarkHostile(enemyChar)

    local erp = enemyChar and enemyChar:FindFirstChild("HumanoidRootPart")
    if not erp then return end
    local d = (erp.Position - root.Position).Magnitude
    if d > DodgeRange then return end

    local toUs = (root.Position - erp.Position)
    if toUs.Magnitude < 0.01 then return end
    toUs = toUs.Unit
    local facing = erp.CFrame.LookVector
    if facing:Dot(toUs) < 0.35 then return end

    local landing = PredictEnemyAttackLanding(enemyChar)
    local incomingDir
    if landing then
        incomingDir = (root.Position - landing)
        if incomingDir.Magnitude > 0.01 then
            incomingDir = incomingDir.Unit
        else
            incomingDir = (root.Position - erp.Position).Unit
        end
    else
        incomingDir = (root.Position - erp.Position).Unit
    end

    local incomingVel = erp.AssemblyLinearVelocity or Vector3.zero
    local perp = incomingDir:Cross(Vector3.new(0, 1, 0))
    if perp.Magnitude < 0.1 then
        perp = incomingVel:Cross(Vector3.new(0, 1, 0))
    end
    if perp.Magnitude < 0.1 then
        perp = Vector3.new(1, 0, 0)
    end
    perp = perp.Unit

    if incomingVel.Magnitude > 1 then
        local velSide = incomingVel.Unit:Cross(Vector3.new(0, 1, 0))
        if velSide.Magnitude > 0.1 then
            velSide = velSide.Unit
            if velSide:Dot(perp) < 0 then perp = -perp end
        end
    end

    local side = (math.random() < 0.5) and 1 or -1
    dodgeDir = (perp * side * 0.95 - incomingDir * 0.25).Unit
    dodgeEndTime = tick() + DodgeDuration
    dodgeLastTrigger = tick()
    dodgeThreatVel = incomingVel
end

local function WatchEnemy(ec)
    if not ec or enemyToolConns[ec] then return end
    enemyToolConns[ec] = {}

    local function onChild(child)
        if child:IsA("Tool") then
            local c = child:GetPropertyChangedSignal("Enabled"):Connect(function()
                if child.Enabled then OnEnemyAttack(ec) end
            end)
            table.insert(enemyToolConns[ec], c)
        end
    end

    for _, child in pairs(ec:GetChildren()) do onChild(child) end
    table.insert(enemyToolConns[ec], ec.ChildAdded:Connect(onChild))
end

local function UnwatchEnemy(ec)
    local conns = enemyToolConns[ec]
    if not conns then return end
    for _, c in pairs(conns) do pcall(function() c:Disconnect() end) end
    enemyToolConns[ec] = nil
end

