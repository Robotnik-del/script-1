local function ResetPath()
    if S.currentPath then
        pcall(function() S.currentPath:Destroy() end)
    end
    S.currentPath = nil
    S.currentWaypoints = {}
    S.currentWaypointIndex = 1
    S.lastPathTarget = nil
    S.lastPathCompute = 0
    ClearPathDebug()
end

local function ComputePath(startPos, targetPos)
    if not C.UsePathfinding then return nil end

    local now = tick()

    if S.currentPath and S.currentPath.Status == Enum.PathStatus.Success then
        local age = now - S.lastPathCompute
        local shift = S.lastPathTarget and (targetPos - S.lastPathTarget).Magnitude or math.huge
        local stale = age > C.PathTimeout
        local shifted = shift > C.PathTargetShift
        local throttled = age < C.PathRecomputeMin

        if not stale and not shifted then
            return S.currentWaypoints, S.currentWaypointIndex
        end
        if throttled and not stale then
            return S.currentWaypoints, S.currentWaypointIndex
        end
    end

    if S.currentPath then
        pcall(function() S.currentPath:Destroy() end)
        S.currentPath = nil
    end

    S.lastPathCompute = now
    S.lastPathTarget = targetPos

    local path = PathService:CreatePath({
        AgentRadius = C.AgentRadius,
        AgentHeight = C.AgentHeight,
        AgentCanJump = true,
        AgentCanClimb = false,
        WaypointSpacing = C.WaypointSpacing,
        Costs = { Water = 30 }
    })

    local ok = pcall(function() path:ComputeAsync(startPos, targetPos) end)

    if ok and path.Status == Enum.PathStatus.Success then
        S.currentPath = path
        S.currentWaypoints = path:GetWaypoints()
        S.currentWaypointIndex = 2

        path.Blocked:Connect(function()
            if tick() - S.lastPathCompute < C.PathBlockedCooldown then return end
            ResetPath()
        end)

        path.Unblocked:Connect(function()
            ResetPath()
        end)

        DrawPathDebug(S.currentWaypoints)
        return S.currentWaypoints, S.currentWaypointIndex
    end

    if ok and path.Status == Enum.PathStatus.NoPath then
        path:Destroy()
        S.lastPathTarget = nil
        return nil
    end

    if ok and path.Status == Enum.PathStatus.Blocked then
        path:Destroy()
        S.lastPathTarget = nil
        return "BLOCKED"
    end

    path:Destroy()
    return nil
end

local function SmoothMoveTo(hum, targetPos)
    if not hum then return end
    if not S.currentMoveTarget then
        S.currentMoveTarget = targetPos
        S.moveAlpha = 0
    end
    S.moveAlpha = math.min(S.moveAlpha + 0.1, 1)
    S.currentMoveTarget = S.currentMoveTarget:Lerp(targetPos, S.moveAlpha)
    hum:MoveTo(S.currentMoveTarget)
end

local function FollowPath(hum, rootPart)
    if not S.currentPath or #S.currentWaypoints == 0 then return false end
    if S.currentPath.Status ~= Enum.PathStatus.Success then return false end

    local wp = S.currentWaypoints[S.currentWaypointIndex]
    if not wp then return false end

    if wp.Action == Enum.PathWaypointAction.Jump then
        hum.Jump = true
    end

    local myFlat = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z)
    local wpFlat = Vector3.new(wp.Position.X, 0, wp.Position.Z)
    local flatDist = (myFlat - wpFlat).Magnitude

    if flatDist < 5 then
        S.currentWaypointIndex = S.currentWaypointIndex + 1
        if S.currentWaypointIndex > #S.currentWaypoints then
            return false
        end
        wp = S.currentWaypoints[S.currentWaypointIndex]
        if not wp then return false end
    end

    if flatDist > 80 then
        ResetPath()
        return false
    end

    SmoothMoveTo(hum, wp.Position)
    return true
end

local function CheckIfStuck()
    if not root or not humanoid then return false end
    local now = tick()
    local dt = now - S.lastStuckCheck
    S.lastStuckCheck = now
    if dt > 0.5 then dt = 0.016 end

    if humanoid.MoveDirection.Magnitude < 0.1 then
        S.stuckTimer = S.stuckTimer + dt
        if S.stuckTimer > 1.5 then return true end
        return false
    end

    table.insert(S.stuckPositions, root.Position)
    if #S.stuckPositions > 20 then table.remove(S.stuckPositions, 1) end
    if #S.stuckPositions < 15 then return false end

    local dist = (S.stuckPositions[#S.stuckPositions] - S.stuckPositions[1]).Magnitude
    if dist < 3 then
        S.stuckTimer = S.stuckTimer + dt
        if S.stuckTimer > 1.0 then return true end
    else
        S.stuckTimer = 0
        S.stuckAttempts = 0
    end
    return false
end

local function Unstuck()
    if not root or not humanoid then return end
    ResetPath()
    S.stuckAttempts = S.stuckAttempts + 1
    if S.stuckAttempts <= 2 then
        humanoid.Jump = true
        task.wait(0.1)
        local ang = math.random(-60, 60)
        local dir = Vector3.new(math.sin(math.rad(ang)), 0, math.cos(math.rad(ang)))
        if dir.Magnitude > 0.1 then
            dir = dir.Unit
            humanoid:MoveTo(root.Position + dir * 15)
            S.stuckDirection = dir
        end
    elseif S.stuckAttempts <= 4 then
        local right = S.stuckDirection:Cross(Vector3.new(0, 1, 0))
        if right.Magnitude > 0.1 then
            right = right.Unit
            local side = (S.stuckAttempts % 2 == 0) and right or -right
            humanoid:MoveTo(root.Position + side * 20)
            humanoid.Jump = true
        end
    else
        humanoid:MoveTo(root.Position - S.stuckDirection * 25)
        humanoid.Jump = true
        S.stuckAttempts = 0
    end
    S.stuckPositions = {}
    S.stuckTimer = 0
end

local function CanJump()
    if not humanoid then return false end
    local st = humanoid:GetState()
    if st == Enum.HumanoidStateType.Jumping then return false end
    if st == Enum.HumanoidStateType.Freefall then return false end
    return true
end

local function IsObstacleAhead(forwardDist)
    if not root or not humanoid then return false end
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {character}
    rp.FilterType = Enum.RaycastFilterType.Blacklist

    local fwd
    local md = humanoid.MoveDirection
    if md.Magnitude > 0.1 then
        fwd = md * Vector3.new(1, 0, 1)
    else
        fwd = root.CFrame.LookVector * Vector3.new(1, 0, 1)
    end
    if fwd.Magnitude < 0.1 then return false end
    fwd = fwd.Unit

    local origins = {
        root.Position + Vector3.new(0, -2, 0),
        root.Position + Vector3.new(0, 1, 0),
        root.Position,
    }
    for _, origin in ipairs(origins) do
        local hit = workspace:Raycast(origin, fwd * forwardDist, rp)
        if hit then return true end
    end
    return false
end

local function RandomJump()
    if not humanoid or not root then return end
    if not CanJump() then return end

    local now = tick()
    if now - S.lastJumpTime < S.jumpCooldown then return end

    local doJump = false
    if S.isStuck then
        doJump = true
    elseif IsObstacleAhead(6) then
        doJump = true
    elseif math.random(1, 100) <= 25 then
        doJump = true
    end

    if doJump then
        S.lastJumpTime = now
        S.jumpCooldown = math.random(C.jumpCooldownMin * 10, C.jumpCooldownMax * 10) / 10
        humanoid.Jump = true
    end
end

local function UpdateFlankMode()
    local now = tick()
    if now - S.flankTimer > S.flankDuration then
        S.flankTimer = now
        if math.random(1, 100) < 55 then
            S.flankMode = true
            S.flankDuration = math.random(1, 3)
        else
            S.flankMode = false
            S.flankDuration = math.random(2, 4)
        end
    end
end

-- I hate this feature, bitch, I spent a lot of time on it Initially, I wrote it much smarter, but it didn't work and I had to turn it into this
local function PressAbilityKey(k)
    if not k then return end
    VIM:SendKeyEvent(true, k, false, nil)
    task.wait(0.1)
    VIM:SendKeyEvent(false, k, false, nil)
end

local function AbilityLoop()
    if S.abilityLoopRunning then return end
    S.abilityLoopRunning = true
    task.spawn(function()
        while C.Enabled and C.Active do
            if C.UseAbilities then
                local keys = C.AbilityKeysList
                if keys and #keys > 0 then
                    if C.AbilityMode == "First" then
                        PressAbilityKey(keys[1])
                    elseif C.AbilityMode == "All" then
                        for _, k in ipairs(keys) do
                            if not (C.Enabled and C.Active) then break end
                            PressAbilityKey(k)
                            task.wait(0.15)
                        end
                    else
                        local k = keys[C.AbilityCycleIndex]
                        PressAbilityKey(k)
                        C.AbilityCycleIndex = (C.AbilityCycleIndex % #keys) + 1
                    end
                end
            end
            task.wait(math.random(
                math.floor(C.AbilityMinInterval * 10),
                math.floor(C.AbilityMaxInterval * 10)
            ) / 10)
        end
        S.abilityLoopRunning = false
    end)
end

local function UseAbility(dist, target)
    AbilityLoop()
end

local function GetPortalTargetPart(portal)
    if not portal then return nil end
    local gate = portal:FindFirstChild("gate")
    if gate then
        if gate:IsA("BasePart") then return gate end
        if gate:IsA("Model") then
            return gate.PrimaryPart or gate:FindFirstChildWhichIsA("BasePart")
        end
    end
    return portal.PrimaryPart or portal:FindFirstChildWhichIsA("BasePart")
end

local function FindPortal()
    local now = tick()
    if now - S.LastPortalSearch < 1 then return S.PortalCache end
    S.LastPortalSearch = now
    local portales = workspace:FindFirstChild("portale")
    if portales then
        S.PortalCache = portales
        return portales
    end
    S.PortalCache = nil
    return nil
end

local function WalkToPortal(portal)
    if not portal or not humanoid or not root then return end
    local pPart = GetPortalTargetPart(portal)
    if not pPart then return end

    local wps = ComputePath(root.Position, pPart.Position)
    if wps and wps ~= "BLOCKED" then
        FollowPath(humanoid, root)
    else
        SmoothMoveTo(humanoid, pPart.Position)
    end

    local d = (root.Position - pPart.Position).Magnitude
    if d < 4 then
        pcall(function() firetouchinterest(root, pPart, 0) end)
        pcall(function() firetouchinterest(root, pPart, 1) end)
        pcall(function() firetouchinterest(humanoid, pPart, 0) end)
        pcall(function() firetouchinterest(humanoid, pPart, 1) end)
    end
end

local function PredictEnemyAttackLanding(enemyChar)
    local erp = enemyChar:FindFirstChild("HumanoidRootPart")
    if not erp or not root then return nil end
    local dir = (root.Position - erp.Position)
    if dir.Magnitude < 0.01 then return nil end
    dir = dir.Unit
    local dist = (root.Position - erp.Position).Magnitude
    local pingComp = GetCombinedPing(enemyChar)
    local enemyVel = erp.AssemblyLinearVelocity or Vector3.zero
    local proj = dir * dist + enemyVel * (pingComp + C.DodgeReaction)
    return erp.Position + proj
end

local function OnEnemyAttack(enemyChar)
    if not C.UseDodge then return end
    if not character or not root or not humanoid then return end
    if tick() - S.dodgeLastTrigger < C.DodgeCooldown then return end

    MarkHostile(enemyChar)
    S.lastAttackTime[enemyChar] = tick()

    local erp = enemyChar and enemyChar:FindFirstChild("HumanoidRootPart")
    if not erp then return end
    local d = (erp.Position - root.Position).Magnitude
    if d > C.DodgeRange then return end

    local toUs = (root.Position - erp.Position)
    if toUs.Magnitude < 0.01 then return end
    toUs = toUs.Unit
    local facing = erp.CFrame.LookVector
    if facing:Dot(toUs) < 0.35 then return end

    local landing = PredictEnemyAttackLanding(enemyChar)
    local incomingDir
    if landing then
        incomingDir = (root.Position - landing)
        if incomingDir.Magnitude > 0.01 then
            incomingDir = incomingDir.Unit
        else
            incomingDir = (root.Position - erp.Position).Unit
        end
    else
        incomingDir = (root.Position - erp.Position).Unit
    end

    local incomingVel = erp.AssemblyLinearVelocity or Vector3.zero
    local perp = incomingDir:Cross(Vector3.new(0, 1, 0))
    if perp.Magnitude < 0.1 then
        perp = incomingVel:Cross(Vector3.new(0, 1, 0))
    end
    if perp.Magnitude < 0.1 then
        perp = Vector3.new(1, 0, 0)
    end
    perp = perp.Unit

    if incomingVel.Magnitude > 1 then
        local velSide = incomingVel.Unit:Cross(Vector3.new(0, 1, 0))
        if velSide.Magnitude > 0.1 then
            velSide = velSide.Unit
            if velSide:Dot(perp) < 0 then perp = -perp end
        end
    end

    local side = (math.random() < 0.5) and 1 or -1
    S.dodgeDir = (perp * side * 0.95 - incomingDir * 0.25).Unit
    S.dodgeEndTime = tick() + C.DodgeDuration
    S.dodgeLastTrigger = tick()
    S.dodgeThreatVel = incomingVel
end

local function WatchEnemy(ec)
    if not ec or S.watchedModels[ec] then return end
    S.watchedModels[ec] = {}

    local function bindTool(child)
        if child:IsA("Tool") then
            local connEnabled = child:GetPropertyChangedSignal("Enabled"):Connect(function()
                if child.Enabled then OnEnemyAttack(ec) end
            end)
            local connActivated = child.Activated:Connect(function()
                S.lastAttackTime[ec] = tick()
                OnEnemyAttack(ec)
            end)
            table.insert(S.watchedModels[ec], connEnabled)
            table.insert(S.watchedModels[ec], connActivated)
        end
    end

    for _, child in pairs(ec:GetChildren()) do bindTool(child) end
    table.insert(S.watchedModels[ec], ec.ChildAdded:Connect(bindTool))
end

local function UnwatchEnemy(ec)
    local conns = S.watchedModels[ec]
    if not conns then return end
    for _, c in pairs(conns) do pcall(function() c:Disconnect() end) end
    S.watchedModels[ec] = nil
end

local function ApplyDodge(hum)
    if tick() >= S.dodgeEndTime then return false end
    if not root then return false end

    local target = root.Position + S.dodgeDir * 22

    local checkParams = RaycastParams.new()
    checkParams.FilterDescendantsInstances = {character}
    checkParams.FilterType = Enum.RaycastFilterType.Blacklist
    local hit = workspace:Raycast(root.Position + Vector3.new(0, 2, 0),
        (target - root.Position).Unit * 22, checkParams)
    if hit then
        target = root.Position + S.dodgeDir * (hit.Distance - 2)
    end

    hum:MoveTo(target)
    if math.random(1, 100) <= 70 then
        hum.Jump = true
    end
    return true
end

local function FindBest(tool, part, predictedPos)
    if not part or not root then return nil end
    if not tool then
        local flatAim = (part.Position - root.Position) * Vector3.new(1, 0, 1)
        if flatAim.Magnitude > 0.1 then
            return CFrame.new(root.Position, root.Position + flatAim.Unit)
        end
        return nil
    end
    local handle = tool:FindFirstChild("Handle")
    if not handle then
        local flatAim = (part.Position - root.Position) * Vector3.new(1, 0, 1)
        if flatAim.Magnitude > 0.1 then
            return CFrame.new(root.Position, root.Position + flatAim.Unit)
        end
        return nil
    end

    local swordTip = (handle.CFrame * CFrame.new(0, 0, -(handle.Size.Z / 2 + 2))).Position
    local aimPos = predictedPos or part.Position

    local offsets = {
        Vector3.new(0, 0, 0),
        Vector3.new(0.5, 0, 0), Vector3.new(-0.5, 0, 0),
        Vector3.new(0, 0.5, 0), Vector3.new(0, -0.5, 0),
        Vector3.new(1, 0, 0),  Vector3.new(-1, 0, 0),
        Vector3.new(0.5, 0.5, 0), Vector3.new(-0.5, -0.5, 0),
        Vector3.new(0, 0, 1), Vector3.new(0, 0, -1)
    }

    local bestPos, bestDist = nil, math.huge
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    rp.FilterDescendantsInstances = {character, part.Parent}

    if C.UseAimAssist then
        for _, off in ipairs(offsets) do
            local check = aimPos + off
            local dir = (check - swordTip)
            if dir.Magnitude > 0.01 then
                local result = workspace:Raycast(swordTip, dir.Unit * 100, rp)
                if result and result.Instance:IsDescendantOf(part.Parent) then
                    local d = (result.Position - swordTip).Magnitude
                    if d < bestDist then bestDist = d; bestPos = result.Position end
                end
            end
        end
    end

    if bestPos then
        local flat = (bestPos - swordTip) * Vector3.new(1, 0, 1)
        if flat.Magnitude > 0.1 then
            return CFrame.new(root.Position, root.Position + flat.Unit)
        end
    end

    local flatAim = (aimPos - root.Position) * Vector3.new(1, 0, 1)
    if flatAim.Magnitude > 0.1 then
        return CFrame.new(root.Position, root.Position + flatAim.Unit)
    end
    return nil
end

local function TryPickupCandy()
    if not root or not humanoid then return false end
    local candy = FindCandyCorn()
    if not candy or not candy.Parent then
        S.CurrentCandyTarget = nil
        return false
    end

    local candyPos = candy.Position
    local d = (candyPos - root.Position).Magnitude
    if d > C.CandyPickupRadius then
        S.CurrentCandyTarget = nil
        return false
    end

    S.CurrentCandyTarget = candy
    DisableGyro()
    ResetPath()
    S.currentMoveTarget = nil

    if d <= C.CandyForcePickupDist then
        S.RecentlyCollected[candy] = tick()
        pcall(function() firetouchinterest(root, candy, 0) end)
        pcall(function() firetouchinterest(root, candy, 1) end)
        S.LastCandyTouch = tick()
        return true
    end

    SmoothMoveTo(humanoid, candyPos)
    return true
end

local function CombotBotLoop()
    if not C.Active or not character or not root or not humanoid then return end

    if C.RequireToolMode and not HasTool() then
        DisableGyro()
        S.currentMoveTarget = nil
        return
    end

    if tick() < S.PortalPauseUntil then
        DisableGyro()
        S.currentMoveTarget = nil
        return
    end

    if C.CandyFarmEnabled then
        ScanEntities()
        if TryPickupCandy() then
            return
        end
    end

    local hpRatio = humanoid.Health / math.max(humanoid.MaxHealth, 1)
    local threatCount = 0
    local threatCenter = Vector3.zero
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r and (r.Position - root.Position).Magnitude < 35 then
                threatCount = threatCount + 1
                threatCenter = threatCenter + r.Position
            end
        end
    end
    if threatCount > 0 then threatCenter = threatCenter / threatCount end

    if C.UseRetreat and
       ((hpRatio < C.RetreatHPThreshold and threatCount >= 1) or threatCount >= C.MultiThreatCount) then
        local fleeDir
        if threatCount > 0 then
            fleeDir = (root.Position - threatCenter) * Vector3.new(1, 0, 1)
        else
            fleeDir = -root.CFrame.LookVector * Vector3.new(1, 0, 1)
        end
        if fleeDir.Magnitude < 0.1 then fleeDir = Vector3.new(1, 0, 0) end
        fleeDir = fleeDir.Unit

        local fleePos = root.Position + fleeDir * 40
        local wps = ComputePath(root.Position, fleePos)
        if wps and wps ~= "BLOCKED" then
            FollowPath(humanoid, root)
        else
            SmoothMoveTo(humanoid, fleePos)
        end

        local t = GetTarget()
        if t then
            local tr = t:FindFirstChild("HumanoidRootPart")
            if tr then
                EnableGyro()
                SetFacing(CFrame.new(root.Position,
                    Vector3.new(tr.Position.X, root.Position.Y, tr.Position.Z)))
            end
        end
        return
    end

    local target
    if C.CandyFarmEnabled then
        target = GetCandyFarmModelTarget()
        if not target then
            DisableGyro()
            S.currentMoveTarget = nil
            return
        end
    else
        target = GetTarget()
    end

    if not target then
        DisableGyro()
        S.currentMoveTarget = nil
        S.lastTargetRef = nil
        S.targetHistory = {}
        return
    end

    if target ~= S.lastTargetRef then
        S.targetHistory = {}
        S.lastTargetRef = target
    end

    local h = target:FindFirstChildOfClass("Humanoid")
    local r = target:FindFirstChild("HumanoidRootPart")
    if not r then
        r = GetModelRoot(target)
    end
    if not r then
        DisableGyro()
        S.currentMoveTarget = nil
        S.lastTargetRef = nil
        S.targetHistory = {}
        return
    end

    if not h then
        EnableGyro()
        humanoid.AutoRotate = false

        local moundHb = 2
        if r then
            moundHb = math.max(r.Size.X, r.Size.Y, r.Size.Z) / 2
        end
        local myHb = GetMyHitboxSize()
        local optimalDist = C.AttackDistance + moundHb + myHb
        if optimalDist < 2.5 then optimalDist = 2.5 end

        local dirToTarget = (r.Position - root.Position) * Vector3.new(1, 0, 1)
        if dirToTarget.Magnitude < 0.1 then
            dirToTarget = Vector3.new(1, 0, 0)
        else
            dirToTarget = dirToTarget.Unit
        end
        SetFacing(CFrame.new(root.Position, root.Position + dirToTarget))

        local d = (r.Position - root.Position).Magnitude
        local approachDist = optimalDist * 0.85
        if approachDist < 2 then approachDist = 2 end

        if d > approachDist + 0.5 then
            ResetPath()
            S.currentMoveTarget = nil
            local targetPos = r.Position - dirToTarget * approachDist
            SmoothMoveTo(humanoid, targetPos)
        else
            ResetPath()
            S.currentMoveTarget = nil
            local tool = character:FindFirstChildOfClass("Tool")
            if tool then
                local now = tick()
                if now - (S.lastMoundAttack or 0) > 0.4 then
                    S.lastMoundAttack = now
                    tool:Activate()
                end
            end
            if humanoid and not humanoid.AutoRotate then
                SetFacing(CFrame.new(root.Position, root.Position + dirToTarget))
            end
        end
        return
    end

    if target:FindFirstChildOfClass("ForceField") then
        local dirAway = (root.Position - r.Position) * Vector3.new(1,0,1)
        if dirAway.Magnitude < 0.1 then dirAway = Vector3.new(1,0,0) end
        humanoid:MoveTo(root.Position + dirAway.Unit * 15)
        DisableGyro()
        return
    end

    EnableGyro()
    humanoid.AutoRotate = false

    local tool = character:FindFirstChildOfClass("Tool")
    if C.autoEquip and not tool then
        local bt = player.Backpack:FindFirstChildOfClass("Tool")
        if bt then
            humanoid:EquipTool(bt)
            task.wait(0.1)
            tool = character:FindFirstChildOfClass("Tool")
        end
    end

    UseAbility((root.Position - r.Position).Magnitude, target)

    S.isStuck = CheckIfStuck()
    if S.isStuck then Unstuck(); return end

    local predictedPos, targetSpeed = PredictTargetPosition(target)
    if not predictedPos then predictedPos = r.Position end

    local enemyHb = GetEnemyHitboxSize(target)
    local myHb    = GetMyHitboxSize()
    local optimalDist = C.AttackDistance + enemyHb + myHb

    local dist = (root.Position - r.Position).Magnitude
    local heightDiff = r.Position.Y - root.Position.Y
    local dirToTarget = (predictedPos - root.Position) * Vector3.new(1, 0, 1)
    if dirToTarget.Magnitude < 0.1 then dirToTarget = Vector3.new(1, 0, 0) end
    dirToTarget = dirToTarget.Unit

    local bestCFrame = FindBest(tool, r, predictedPos)

    local adj = optimalDist
    if targetSpeed > 5 then adj = optimalDist * 0.85
    elseif targetSpeed < 2 then adj = optimalDist * 0.7 end

    local faceCF = bestCFrame or CFrame.new(root.Position, root.Position + dirToTarget)
    SetFacing(faceCF)

    if C.UseDodge and ApplyDodge(humanoid) then
        SetFacing(CFrame.new(root.Position, root.Position + S.dodgeDir))
        return
    end

    UpdateFlankMode()

    local movePos = nil
    if S.flankMode then
        local behindPos = r.Position + r.CFrame.LookVector * (adj * 1.1)
        if math.random(1, 100) <= 30 and CanJump() and tick() - S.lastJumpTime > 0.5 then
            humanoid.Jump = true
            S.lastJumpTime = tick()
        end
        movePos = behindPos
    elseif dist > adj * 1.2 then
        local approach = predictedPos - dirToTarget * (adj * 0.9)
        approach = Vector3.new(approach.X, root.Position.Y + heightDiff * 0.3, approach.Z)
        movePos = approach
    elseif dist < adj * 0.5 then
        local escapeDir = -dirToTarget + (dirToTarget:Cross(Vector3.new(0, 1, 0)) * 0.8)
        movePos = root.Position + escapeDir.Unit * (adj - dist + 8)
    else
        local circle = (root.Position - predictedPos) * Vector3.new(1, 0, 1)
        if circle.Magnitude < 0.1 then circle = Vector3.new(1, 0, 0) end
        circle = circle.Unit:Cross(Vector3.new(0, 1, 0))
        if circle.Magnitude < 0.1 then circle = Vector3.new(1, 0, 0) end

        local strafeDist = 6 + C.StrafeAmount * 2
        local rand = Vector3.new(
            (math.random() - 0.5) * C.StrafeAmount,
            0,
            (math.random() - 0.5) * C.StrafeAmount
        )
        movePos = predictedPos + circle * strafeDist + rand

        if math.random(1, 100) <= 25 and tick() - S.lastJumpTime > 0.8 then
            local sideDir = circle * (1 + math.random() * 1.5)
            movePos = root.Position + sideDir * strafeDist + rand
            if CanJump() then
                humanoid.Jump = true
                S.lastJumpTime = tick()
                S.jumpCooldown = math.random(C.jumpCooldownMin * 10, C.jumpCooldownMax * 10) / 10
            end
        end
    end

    if movePos then
        local combatRange = adj * 1.5
        local enemyClose = dist < combatRange
        local hasSight = HasLOS(root.Position, movePos)

        if enemyClose and hasSight then
            ResetPath()
            SmoothMoveTo(humanoid, movePos)
        else
            local wps = ComputePath(root.Position, movePos)
            if wps == "BLOCKED" then
                ResetPath()
                S.currentMoveTarget = nil
                DisableGyro()
                return
            elseif wps then
                FollowPath(humanoid, root)
            else
                if hasSight then
                    ResetPath()
                    SmoothMoveTo(humanoid, movePos)
                else
                    DisableGyro()
                    S.currentMoveTarget = nil
                    return
                end
            end
        end
    end

    if humanoid and not humanoid.AutoRotate then
        SetFacing(faceCF)
    end

    RandomJump()

    local shouldAttack = false
    if tool or not C.RequireToolMode then
        local lookDir = root.CFrame.LookVector
        local toTarget = (r.Position - root.Position)
        if toTarget.Magnitude > 0.01 then
            local dot = lookDir:Dot(toTarget.Unit)
            if dist <= adj * 1.1 and dot > 0.7 then shouldAttack = true end
            if dist <= adj * 0.75 then shouldAttack = true end
            if targetSpeed < 1 and dist <= adj * 1.15 and dot > 0.5 then shouldAttack = true end
        end
    end
    if shouldAttack then
        local activeTool = character:FindFirstChildOfClass("Tool")
        if activeTool and activeTool.Parent == character then
            activeTool:Activate()
        else
            local mouse = player:GetMouse()
            if mouse then
                VIM:SendMouseButtonEvent(mouse.X, mouse.Y, 0, true, game, 0)
                VIM:SendMouseButtonEvent(mouse.X, mouse.Y, 0, false, game, 0)
            end
        end
    end
end

local function StopBot()
    ResetPath()
    S.currentMoveTarget = nil
    S.stuckPositions = {}
    S.stuckTimer = 0
    S.isStuck = false
    S.flankMode = false
    S.lastJumpTime = 0
    S.targetHistory = {}
    S.lastTargetRef = nil
    S.dodgeEndTime = 0
    S.CurrentCandyTarget = nil
    DisableGyro()
    if humanoid then humanoid.WalkSpeed = S.DefaultWalkSpeed end
    ClearPathDebug()
end

local function HookHealthTracker()
    if not humanoid then return end
    humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if not root then return end
        if humanoid.Health >= humanoid.MaxHealth then return end
        local now = tick()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local ch = p.Character
                local r = ch:FindFirstChild("HumanoidRootPart")
                if r then
                    local dist = (r.Position - root.Position).Magnitude
                    local armed = ch:FindFirstChildOfClass("Tool") ~= nil
                    local recent = S.lastAttackTime[ch] and (now - S.lastAttackTime[ch] < 1.2)
                    local toUs = (root.Position - r.Position)
                    local facingDot = 0
                    if toUs.Magnitude > 0.01 then
                        facingDot = r.CFrame.LookVector:Dot(toUs.Unit)
                    end
                    if dist < 30 and (recent or armed) and facingDot > 0.2 then
                        MarkHostile(ch)
                    end
                end
            end
        end
    end)
end

