local function PredictTargetPosition(target)
    local r = target:FindFirstChild("HumanoidRootPart")
    if not r then return nil, 0 end

    local now = tick()
    local pingComp = GetCombinedPing(target)

    table.insert(S.targetHistory, {pos = r.Position, time = now})
    while #S.targetHistory > 12 or (#S.targetHistory > 0 and now - S.targetHistory[1].time > 0.5) do
        table.remove(S.targetHistory, 1)
    end

    if #S.targetHistory < 3 then
        return r.Position, 0
    end

    local oldest = S.targetHistory[1]
    local newest = S.targetHistory[#S.targetHistory]
    local dt = newest.time - oldest.time
    if dt < 0.02 then return r.Position, 0 end

    local avgVel = (newest.pos - oldest.pos) / dt

    local accel = Vector3.zero
    if #S.targetHistory >= 3 then
        local a = S.targetHistory[#S.targetHistory - 2]
        local b = S.targetHistory[#S.targetHistory - 1]
        local c = S.targetHistory[#S.targetHistory]
        local v1 = (b.pos - a.pos) / math.max(b.time - a.time, 0.001)
        local v2 = (c.pos - b.pos) / math.max(c.time - b.time, 0.001)
        accel = (v2 - v1) / math.max(c.time - a.time, 0.001)
    end

    local t = pingComp * C.PredictPingFactor + C.PredictBaseTime
    local predicted = r.Position
        + avgVel * t * C.PredictVelocityFactor
        + accel * (t * t) * C.PredictAccelFactor

    if C.UseAntiAir then
        local th = target:FindFirstChildOfClass("Humanoid")
        if th and th.FloorMaterial == Enum.Material.Air then
            local g = workspace.Gravity
            local yOff = avgVel.Y * t - 0.5 * g * t * t
            predicted = Vector3.new(predicted.X, r.Position.Y + yOff, predicted.Z)
        end
    end

    local offset = predicted - r.Position
    if offset.Magnitude > C.PredictMaxDistance then
        predicted = r.Position + offset.Unit * C.PredictMaxDistance
    end

    return predicted, avgVel.Magnitude
end

