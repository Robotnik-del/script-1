task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if not character or not character.Parent then UpdateCharRefs() end
        UpdatePingSystem()

        if bodyGyro and bodyGyro.Parent == root and humanoid and humanoid.AutoRotate then
            humanoid.AutoRotate = false
        end

        if C.Enabled and C.Active and character and root and humanoid and not S.botBusy then
            local now = tick()
            if now - S.lastBotSpawn >= 0.03 then
                S.lastBotSpawn = now
                S.botBusy = true
                task.spawn(function()
                    pcall(CombotBotLoop)
                    S.botBusy = false
                end)
            end
        end

        if C.AutoPortalEnabled and C.Active and character and root and humanoid then
            local portal = FindPortal()
            if portal then
                local pPart = GetPortalTargetPart(portal)
                if pPart then
                    local d = (root.Position - pPart.Position).Magnitude
                    if d <= C.PortalRadius then
                        if not S.PortalInsideFlag then
                            S.PortalPauseUntil = tick() + C.PortalPauseTime
                            S.PortalInsideFlag = true
                        end
                        WalkToPortal(portal)
                    else
                        S.PortalInsideFlag = false
                    end
                end
            else
                S.PortalInsideFlag = false
            end
        end
    end
end)

