local function IsAlive(model)
    if not model then return false end
    local h = model:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function GetClientPing()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and v then return math.min(v / 1000, 0.5) end
    return 0.05
end

local function UpdateServerPing()
    local now = tick()
    if now - ServerPingTime < 1 then return end
    ServerPingTime = now
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and v then ServerPing = v / 1000 end
end

local function GetCombinedPing()
    if UseServerPing then
        return math.max(GetClientPing(), ServerPing)
    end
    return GetClientPing()
end

local function HasLOS(pos1, pos2, ignoreList)
    local p = RaycastParams.new()
    p.FilterDescendantsInstances = ignoreList or {character}
    p.FilterType = Enum.RaycastFilterType.Blacklist
    local dir = pos2 - pos1
    local dist = dir.Magnitude
    if dist < 0.01 then return true end
    return workspace:Raycast(pos1, dir.Unit * dist, p) == nil
end

local function IsNPC(model)
    if not model or not model:IsA("Model") then return false end
    local h = model:FindFirstChildOfClass("Humanoid")
    if not h then return false end
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character == model then return false end
    end
    local n = model.Name:lower()
    if n:find("stand") or n:find("trolllook") then return false end
    return true
end

local function UpdateNPCCache()
    local now = tick()
    if now - LastNPCCacheUpdate < NPCCacheUpdateInterval then return end
    LastNPCCacheUpdate = now
    NPCCache = {}
    local function scan(container, depth)
        if depth > 2 then return end
        for _, m in pairs(container:GetChildren()) do
            if m:IsA("Model") and IsNPC(m) then
                local rp = m:FindFirstChild("HumanoidRootPart")
                if rp and rp:IsA("BasePart") then
                    NPCCache[m] = rp
                end
            elseif (m:IsA("Folder") or m:IsA("Model")) and m ~= character then
                scan(m, depth + 1)
            end
        end
    end
    scan(workspace, 0)
end

