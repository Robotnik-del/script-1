local function ScanEntities()
    local now = tick()
    if not EntityCache.Dirty and now - EntityCache.LastScan < 0.3 then return end
    EntityCache.LastScan = now
    EntityCache.Dirty = false

    local candy, mounds, enemies = {}, {}, {}

    local function scan(container, depth)
        if depth > 3 then return end
        for _, obj in pairs(container:GetChildren()) do
            if obj:IsA("BasePart") then
                if obj.Name == "CandyCorn" then
                    candy[#candy + 1] = obj
                end
            elseif obj:IsA("Model") then
                if obj ~= character then
                    local n = obj.Name
                    if n == "Mound" then
                        if IsAlive(obj) then mounds[#mounds + 1] = obj end
                    elseif n == "Candy Troll" or n == "Witch Attacker" then
                        if IsAlive(obj) then enemies[#enemies + 1] = obj end
                    end
                    scan(obj, depth + 1)
                end
            elseif obj:IsA("Folder") then
                scan(obj, depth + 1)
            end
        end
    end
    scan(workspace, 0)

    EntityCache.CandyCorn = candy
    EntityCache.Mounds = mounds
    EntityCache.CandyEnemies = enemies
end

local function FindClosestFromList(list)
    if not root then return nil end
    local rp = root.Position
    local maxD2 = C.CandyMaxSearchDist * C.CandyMaxSearchDist
    local best, bestDist2 = nil, maxD2
    for i = 1, #list do
        local obj = list[i]
        local pos
        if obj:IsA("BasePart") then
            pos = obj.Position
        else
            local r = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart")
            if r then pos = r.Position end
        end
        if pos then
            local dx = pos.X - rp.X
            local dy = pos.Y - rp.Y
            local dz = pos.Z - rp.Z
            local d2 = dx*dx + dy*dy + dz*dz
            if d2 < bestDist2 then
                bestDist2 = d2
                best = obj
            end
        end
    end
    return best
end

local function FindCandyCorn()
    if not root then return nil end
    local rp = root.Position
    local maxD2 = C.CandyMaxSearchDist * C.CandyMaxSearchDist
    local best, bestDist2 = nil, maxD2
    local list = EntityCache.CandyCorn
    local now = tick()
    for i = 1, #list do
        local obj = list[i]
        if obj.Parent then
            local marked = S.RecentlyCollected[obj]
            if not marked or (now - marked) >= 3 then
                local pos = obj.Position
                local dx = pos.X - rp.X
                local dy = pos.Y - rp.Y
                local dz = pos.Z - rp.Z
                local d2 = dx*dx + dy*dy + dz*dz
                if d2 < bestDist2 then
                    bestDist2 = d2
                    best = obj
                end
            end
        end
    end
    return best
end

