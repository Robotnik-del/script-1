local function SampleLocalPing()
    local ok, v = pcall(function() return player:GetNetworkPing() end)
    if ok and v and v > 0 then return math.min(v, 1) end
    return nil
end

local function SampleServerPing()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and v then return math.min(v / 1000, 1) end
    return nil
end

local function SamplePlayerPing(p)
    if not p or not p.Parent then return nil end
    local ok, v = pcall(function() return p:GetNetworkPing() end)
    if ok and v and v > 0 then return math.min(v, 1) end
    return nil
end

local function EMA(old, new, alpha)
    if not new then return old end
    return old * (1 - alpha) + new * alpha
end

local function UpdatePingSystem()
    local now = tick()
    if now - PingSys.LastUpdate < C.PingUpdateInterval then return end
    PingSys.LastUpdate = now

    local a = C.PingSmoothing

    local lp = SampleLocalPing()
    if lp then PingSys.LocalPing = EMA(PingSys.LocalPing, lp, a) end

    local sp = SampleServerPing()
    if sp then PingSys.ServerPing = EMA(PingSys.ServerPing, sp, a) end

    for p in pairs(PingSys.PlayerPings) do
        if not p.Parent then PingSys.PlayerPings[p] = nil end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            local v = SamplePlayerPing(p)
            if v then
                PingSys.PlayerPings[p] = EMA(PingSys.PlayerPings[p] or v, v, a)
            else
                PingSys.PlayerPings[p] = PingSys.PlayerPings[p] or 0.05
            end
        end
    end
end

local function GetTargetPing(target)
    if not target then return PingSys.ServerPing end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character == target then
            return PingSys.PlayerPings[p] or 0.05
        end
    end
    return PingSys.ServerPing
end

local function GetEffectiveLatency(target)
    local ourPing = PingSys.LocalPing
    local srvPing = PingSys.ServerPing
    local theirPing = 0
    if C.UseTargetPing then
        theirPing = GetTargetPing(target)
    end
    local base = (ourPing * 0.6 + srvPing * 0.4) * 0.5
    return base + theirPing * 0.5
end

local function GetCombinedPing(target)
    if target then
        return GetEffectiveLatency(target)
    end
    if C.UseServerPing then
        return math.max(PingSys.LocalPing, PingSys.ServerPing)
    end
    return PingSys.LocalPing
end

local function HasLOS(pos1, pos2, ignoreList)
    local dir = pos2 - pos1
    if dir.Magnitude < 0.01 then return true end
    losParams.FilterDescendantsInstances = ignoreList or {character}
    return workspace:Raycast(pos1, dir, losParams) == nil
end

local function IsPlayerCharacter(model)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character == model then return true end
    end
    return false
end

local function IsNPC(model)
    if not model or not model:IsA("Model") then return false end
    local h = model:FindFirstChildOfClass("Humanoid")
    if not h then return false end
    if IsPlayerCharacter(model) then return false end
    if model == character then return false end
    local n = model.Name:lower()
    if n:find("stand") or n:find("trolllook") or n:find("dummy") then
        return false
    end
    return true
end

local function UpdateNPCCache()
    local now = tick()
    if now - S.LastNPCCacheUpdate < S.NPCCacheUpdateInterval then return end
    S.LastNPCCacheUpdate = now
    S.NPCCache = {}
    local function scan(container, depth)
        if depth > 2 then return end
        for _, m in pairs(container:GetChildren()) do
            if m:IsA("Model") and IsNPC(m) then
                local rp = m:FindFirstChild("HumanoidRootPart")
                if rp and rp:IsA("BasePart") then
                    S.NPCCache[m] = rp
                end
            elseif (m:IsA("Folder") or m:IsA("Model")) and m ~= character then
                scan(m, depth + 1)
            end
        end
    end
    scan(workspace, 0)
end

