local function ScoreTarget(model, r)
    if not model or not r then return -math.huge end
    local h = model:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return -math.huge end

    local dist = (r.Position - root.Position).Magnitude
    if dist > C.Radius or dist > C.MaxTargetDistance then return -math.huge end

    local isPlayerChar = IsPlayerCharacter(model)

    if C.CandyFarmEnabled then
        if IsCandyEnemy(model) then
            return 100000 - dist
        end
        if IsMound(model) then
            return 50000 - dist
        end
        if isPlayerChar and C.CandyIgnorePlayers then return -math.huge end
        if (not isPlayerChar) and C.CandyIgnoreOtherNPCs then return -math.huge end
    end

    if C.PassivePlayersMode and isPlayerChar then
        if C.PassiveRetaliate then
            if not IsHostilePlayer(model) and not IsAttackingUs(model) then
                return -math.huge
            end
        else
            return -math.huge
        end
    end

    if C.AttackersOnlyMode and not IsAttackingUs(model) and not IsHostilePlayer(model) then
        return -math.huge
    end

    if C.PreferClosestMode or not C.UseSmartTarget then
        return 10000 - dist
    end

    local score = 0
    score = score + (1000 - dist) * W.Distance

    if isPlayerChar then
        score = score + W.Player
    else
        score = score + W.NPC
    end

    local hpRatio = h.Health / math.max(h.MaxHealth, 1)
    score = score + (1 - hpRatio) * W.LowHP

    if hpRatio < 0.5 then
        score = score + W.AlreadyHurt
    end

    if model == S.LastAttacker and tick() - S.LastAttackerTime < 5 then
        score = score + W.Attacker
    end

    if IsHostilePlayer(model) then
        score = score + W.Attacker
    end

    local toUs = (root.Position - r.Position)
    if toUs.Magnitude > 0.01 then
        toUs = toUs.Unit
        local facing = r.CFrame.LookVector
        if facing:Dot(toUs) < -0.3 then
            score = score + W.BackTurned
        end
    end

    if model:FindFirstChildOfClass("Tool") then
        score = score + W.Armed
    end

    if IsAttackingUs(model) then
        score = score + W.ThreatToMe
    end

    return score
end

local function GetTarget()
    if not character or not root then return nil end
    local best, bestScore = nil, -math.huge

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and IsAlive(p.Character) then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r then
                local sc = ScoreTarget(p.Character, r)
                if sc > bestScore then bestScore = sc; best = p.Character end
            end
        end
    end

    UpdateNPCCache()
    for npc, r in pairs(S.NPCCache) do
        if r and r.Parent and IsAlive(npc) then
            local sc = ScoreTarget(npc, r)
            if sc > bestScore then bestScore = sc; best = npc end
        end
    end

    return best
end

local function GetEnemyHitboxSize(target)
