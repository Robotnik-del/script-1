local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local LP = Players.LocalPlayer

local Remotes = RS:WaitForChild("ReplicatedStorage Package"):WaitForChild("Remote Events")
local SendPacket = Remotes.SendPacket

local Config = {
    PunchBypass = { enabled = false, abilityId = 81285671124281 },
    MiniAura = {
        enabled = false,
        range = 10,
        interval = 0.4,
        abilityId = 81285671124281,
    },
}

local State = {
    lastBypass = 0,
    bypassBusy = false,
    auraThread = nil,
    dragging = false,
    dragStart = nil,
    dragOrigin = nil,
    visible = true,
    gui = nil,
}

local function gc()
    return LP.Character
end

local function gr()
    local c = gc()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function al(m)
    if not m or not m.Parent then
        return false
    end
    local h = m:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function fhp(target)
    if not target then
        return nil
    end
    for _, name in ipairs({"Head", "UpperTorso", "Torso", "HumanoidRootPart", "LeftHand", "RightHand"}) do
        local p = target:FindFirstChild(name)
        if p and p:IsA("BasePart") then
            return p
        end
    end
    return target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
end

local function collectTargets(range)
    local hrp = gr()
    if not hrp then
        return {}
    end
    local myPos = hrp.Position
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and al(plr.Character) then
            local tHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            if tHRP and (tHRP.Position - myPos).Magnitude <= range then
                table.insert(list, plr.Character)
            end
        end
    end
    return list
end

local function sp(target, abilityId, delay)
    local char = gc()
    local hrp = gr()
    if not char or not hrp then
        return
    end
    local hitbox = char:FindFirstChild("Hitbox")
    local weld = hrp:FindFirstChild("Hitbox Weld")
    if not hitbox or not weld then
        return
    end
    local hitPart = fhp(target)
    if not hitPart then
        return
    end
    local camera = workspace.CurrentCamera
    local mousePos = camera.CFrame.Position + camera.CFrame.LookVector * 100
    local realDist = (hitbox.Position - hitPart.Position).Magnitude
    SendPacket:FireServer("Use Ability", "Punch", char:GetPivot(), mousePos, nil)
    if delay and delay > 0 then
        task.wait(delay)
    end
    SendPacket:FireServer(
        "Use Punch",
        abilityId,
        target,
        hitbox.Position + Vector3.new(0, 0.5, 0),
        realDist,
        hitbox.Size,
        weld.C0,
        hitPart,
        hitPart.Size,
        hrp.CFrame.LookVector
    )
end

local function pb()
    local hrp = gr()
    if not hrp then
        return
    end
    local myPos = hrp.Position
    local best, bestDist = nil, 100
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and al(plr.Character) then
            local tHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            if tHRP then
                local d = (tHRP.Position - myPos).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = plr.Character
                end
            end
        end
    end
    if not best then
        return
    end
    pcall(sp, best, Config.PunchBypass.abilityId, 0.05)
end

local function sa()
    if State.auraThread then
        return
    end
    State.auraThread = true
    task.spawn(function()
        while true do
            if Config.MiniAura.enabled then
                local targets = collectTargets(Config.MiniAura.range)
                if #targets > 0 then
                    local target = targets[math.random(#targets)]
                    if target and target.Parent then
                        pcall(sp, target, Config.MiniAura.abilityId, 0)
                    end
                end
                task.wait(Config.MiniAura.interval)
            else
                task.wait(0.2)
            end
        end
    end)
end

local function bui()
    local pg = LP:WaitForChild("PlayerGui")
    local old = pg:FindFirstChild("AbilityWarsUI")
