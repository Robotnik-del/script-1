local function readFaction(npc)
    local ok, v = pcall(function() return npc:GetAttribute("Faction") end)
    if ok and v ~= nil then return tostring(v) end
    local cat = npc:FindFirstChild("Category")
    if cat then
        local ok2, v2 = pcall(function() return cat:GetAttribute("Faction") end)
        if ok2 and v2 ~= nil then return tostring(v2) end
        local f = cat:FindFirstChild("Faction")
        if f then
            if f:IsA("ValueBase") then return tostring(f.Value) end
            local inner = f:FindFirstChildWhichIsA("ValueBase")
            if inner then return tostring(inner.Value) end
        end
    end
    return "Unknown"
end

local function isEnemy(npc)
    if string.find(string.lower(npc.Name), "bathub") then return true end
    local faction = readFaction(npc)
    if faction and string.find(string.lower(tostring(faction)), "bathub") then return true end
    return false
end

local function getRoot(npc)
    return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head") or npc.PrimaryPart
end

local function getMyRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getMyHum()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function isTitan()
    local char = LocalPlayer.Character
    if not char then return false end
    local infected = char:FindFirstChild("InfectedV")
    if infected and infected:IsA("BoolValue") and infected.Value then return true end
    if char:FindFirstChild("Titan") then return true end
    return false
end

local function isValidEnemy(npc)
    if not npc or not npc.Parent then return false end
    local hum = npc:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not getRoot(npc) then return false end
    return true
end

local function hDist(a, b)
    return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function findNearestEnemy()
    local myRoot = getMyRoot()
    if not myRoot or not AIFolder then return nil end
    local best, bestDist = nil, math.huge
    for _, npc in ipairs(AIFolder:GetChildren()) do
        if npc:IsA("Model") and isEnemy(npc) and isValidEnemy(npc) then
            local root = getRoot(npc)
            local d = hDist(myRoot.Position, root.Position)
            if d < bestDist then
                bestDist = d
                best = npc
            end
        end
    end
    return best
end

local function getWeapon()
    local char = LocalPlayer.Character
    if not char then return nil, nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local shoot = tool:FindFirstChild("Shoot")
        if shoot and shoot:IsA("RemoteEvent") then return tool, shoot end
        local fire = tool:FindFirstChild("FireGun")
        if fire and fire:IsA("RemoteEvent") then return tool, fire end
    end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return nil, nil end
    for _, t in ipairs(backpack:GetChildren()) do
        if t:IsA("Tool") then
            local shoot = t:FindFirstChild("Shoot")
            if shoot and shoot:IsA("RemoteEvent") then
                local ok = pcall(function() t.Parent = char end)
                if ok then task.wait(0.1) return t, shoot end
            end
            local fire = t:FindFirstChild("FireGun")
            if fire and fire:IsA("RemoteEvent") then
                local ok = pcall(function() t.Parent = char end)
                if ok then task.wait(0.1) return t, fire end
            end
        end
    end
    return nil, nil
end

local function getShootPart(target)
    if not target then return nil end
    return target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
end

local function endLaser(remote)
    if remote then pcall(function() remote:FireServer("End") end) end
    Bot.IsHoldingLaser = false
    Bot.LaserToken = Bot.LaserToken + 1
end

local function holdLaser(remote, target)
    if Bot.IsHoldingLaser then return end
    local part = getShootPart(target)
    if not part then return end
    Bot.IsHoldingLaser = true
    Bot.LaserStart = tick()
    Bot.LaserToken = Bot.LaserToken + 1
    local myToken = Bot.LaserToken
    task.spawn(function()
        pcall(function() remote:FireServer("Begin", part.Position) end)
        local startT = tick()
        local lastRetarget = 0
        while tick() - startT < Bot.LaserHoldTime do
            if Bot.LaserToken ~= myToken then break end
            if not Bot.Enabled then break end
            if not remote.Parent then break end
            if not isValidEnemy(Bot.Target) then
                if tick() - lastRetarget > 0.2 then
                    lastRetarget = tick()
                    local newTarget = findNearestEnemy()
                    if newTarget then
                        Bot.Target = newTarget
                    else
                        break
                    end
                end
            end
            if isValidEnemy(Bot.Target) then
                local p = getShootPart(Bot.Target)
                if p then
                    pcall(function() remote:FireServer("Update", p.Position) end)
                end
            end
            RS.Heartbeat:Wait()
        end
        pcall(function() remote:FireServer("End") end)
        if Bot.LaserToken == myToken then Bot.IsHoldingLaser = false end
    end)
end

local function shootTarget(target)
    if not isValidEnemy(target) then return end
    local tool, remote = getWeapon()
    if not tool or not remote then return end
    local part = getShootPart(target)
    if not part then return end
    local isLaser = tool:FindFirstChild("Shoot") ~= nil
    if isLaser then
        holdLaser(remote, target)
    else
        pcall(function() remote:FireServer(part.Position) end)
    end
    Bot.LastActionTime = tick()
end

local function useAbility()
    if not Bot.UseAbilities then return end
    local now = tick()
    if now - Bot.LastAbility < Bot.AbilityCooldown then return end
    Bot.LastAbility = now
    if Bot.AbilityMode == "Cycle" then
        local k = Bot.AbilityKeys[Bot.AbilityIndex]
        VIM:SendKeyEvent(true, k, false, nil)
        task.wait(0.08)
        VIM:SendKeyEvent(false, k, false, nil)
        Bot.AbilityIndex = (Bot.AbilityIndex % #Bot.AbilityKeys) + 1
    else
        for _, k in ipairs(Bot.AbilityKeys) do
            VIM:SendKeyEvent(true, k, false, nil)
            task.wait(0.08)
            VIM:SendKeyEvent(false, k, false, nil)
        end
    end
    Bot.LastActionTime = tick()
end

local function moveWithPath(hum, myRoot, targetPos, stopRadius)
    local hd = hDist(myRoot.Position, targetPos)
    if hd <= stopRadius then
        Bot.Waypoints = {}
        Bot.WaypointIndex = 1
        return
    end

    if not Bot.UsePathfinding then
        hum:MoveTo(targetPos)
        return
    end

    if #Bot.Waypoints > 0 and Bot.WaypointIndex <= #Bot.Waypoints then
        local wp = Bot.Waypoints[Bot.WaypointIndex]
        if wp then
            if hDist(myRoot.Position, wp.Position) < 6 then
                Bot.WaypointIndex = Bot.WaypointIndex + 1
                wp = Bot.Waypoints[Bot.WaypointIndex]
            end
            if wp then
                hum:MoveTo(wp.Position)
                if wp.Action == Enum.PathWaypointAction.Jump then
                    hum.Jump = true
                end
                return
            end
        end
    end

    hum:MoveTo(targetPos)

    if Bot.PathComputing then return end
    local now = tick()
    if now - Bot.LastPathTime < 0.4 then return end
    Bot.LastPathTime = now
    Bot.PathComputing = true

    local startPos = myRoot.Position
    task.spawn(function()
        pcall(function()
            local path = PathService:CreatePath({
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = true,
                AgentCanClimb = false
            })
            path:ComputeAsync(startPos, targetPos)
            if path.Status == Enum.PathStatus.Success then
                local wps = path:GetWaypoints()
                if #wps >= 2 then
                    Bot.Waypoints = wps
                    Bot.WaypointIndex = 2
                end
            end
        end)
        Bot.PathComputing = false
    end)
end

local function humanKite(hum, myRoot, targetPos, now)
    local hd = hDist(myRoot.Position, targetPos)

    if now - Bot.LastStrafeFlip > 1.4 then
        Bot.LastStrafeFlip = now
        Bot.StrafeDir = -Bot.StrafeDir
    end

    if hd < Bot.KeepDistance then
        Bot.State = "RETREAT"
        local away = myRoot.Position - targetPos
        local flat = Vector3.new(away.X, 0, away.Z)
        if flat.Magnitude < 0.1 then flat = Vector3.new(1, 0, 0) end
        flat = flat.Unit
        local escapeDist = (Bot.KeepDistance - hd) + 20
        hum:MoveTo(myRoot.Position + flat * escapeDist)
        Bot.Waypoints = {}
        Bot.WaypointIndex = 1
        return
    end

    if hd > Bot.ShootRange then
        Bot.State = "ADVANCE"
        local toTarget = targetPos - myRoot.Position
        local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
        if flat.Magnitude < 0.1 then return end
        flat = flat.Unit
        local stopPos = targetPos - flat * (Bot.ShootRange * 0.85)
        moveWithPath(hum, myRoot, stopPos, 8)
        return
    end

    Bot.State = "ORBIT"
    local toTarget = targetPos - myRoot.Position
    local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
    if flat.Magnitude < 0.1 then return end
    local dir = flat.Unit
    local perp = Vector3.new(-dir.Z, 0, dir.X) * Bot.StrafeDir
    local radialCorrection = 0
    if hd > Bot.KeepDistance + 10 then
        radialCorrection = 0.4
    elseif hd < Bot.KeepDistance + 5 then
        radialCorrection = -0.4
    end
    local radial = dir * radialCorrection
    local moveVec = perp + radial
    if moveVec.Magnitude > 0.1 then
        hum:MoveTo(myRoot.Position + moveVec.Unit * Bot.StrafeSpeed)
    end
    Bot.Waypoints = {}
    Bot.WaypointIndex = 1
end

local function titanRush(hum, myRoot, targetPos)
    Bot.State = "TITAN RUSH"
    moveWithPath(hum, myRoot, targetPos, 3)
end

local function checkStuck(myRoot)
    local now = tick()
    if now - Bot.LastStuckCheck > 0.6 then
        Bot.LastStuckCheck = now
        if Bot.LastPos then
            local moved = (myRoot.Position - Bot.LastPos).Magnitude
            if moved < 2 then
                Bot.StuckTimer = Bot.StuckTimer + 0.6
            else
                Bot.StuckTimer = 0
            end
        end
        Bot.LastPos = myRoot.Position
        if Bot.StuckTimer > 1.8 then
            Bot.StuckTimer = 0
            return true
        end
    end
    return false
end

local function unstuck(hum, myRoot)
    hum.Jump = true
    task.wait(0.05)
    local ang = math.random(-90, 90)
    local dir = Vector3.new(math.sin(math.rad(ang)), 0, math.cos(math.rad(ang)))
    hum:MoveTo(myRoot.Position + dir * 25)
    Bot.Waypoints = {}
    Bot.WaypointIndex = 1
end

local function getAnchorPos(anchor)
    if not anchor then return nil end
    if anchor:IsA("BasePart") then return anchor.Position end
    if anchor:IsA("Attachment") then return anchor.WorldPosition end
    local part = anchor:FindFirstChildWhichIsA("BasePart", true)
    if part then return part.Position end
    return nil
end

local function findDownedPlayer()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local anchor = plr.Character:FindFirstChild("RevivePromptAnchor", true)
            if anchor then
                local prompt = anchor:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and prompt.Enabled then
                    local pos = getAnchorPos(anchor)
                    if pos then
                        return {player = plr, anchor = anchor, prompt = prompt, pos = pos}
                    end
                end
            end
        end
    end
    return nil
end

local function triggerPrompt(prompt)
    if typeof(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, prompt)
        return
    end
    pcall(function()
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration or 0.1)
        prompt:InputHoldEnd()
    end)
end

local function hasImmediateThreat(myPos, radius)
    if not AIFolder then return false end
    for _, npc in ipairs(AIFolder:GetChildren()) do
        if npc:IsA("Model") and isEnemy(npc) and isValidEnemy(npc) then
            local r = getRoot(npc)
            if r and hDist(myPos, r.Position) < radius then
                return true
            end
        end
    end
    return false
end

local function doDamageTeleport()
    local now = tick()
    if now - DamageTP.LastTP < DamageTP.Cooldown then return end
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    DamageTP.LastTP = now

    local currentPos = myRoot.Position
    local currentY = currentPos.Y

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local ignored = WS:FindFirstChild("Ignored")
    local filter = {char}
    if ignored then table.insert(filter, ignored) end
    rayParams.FilterDescendantsInstances = filter

    for attempt = 1, 20 do
        local angle = math.random() * math.pi * 2
        local dist = DamageTP.Distance * (0.6 + math.random() * 0.6)
        local dx = math.cos(angle) * dist
        local dz = math.sin(angle) * dist
        local destX = currentPos.X + dx
        local destZ = currentPos.Z + dz
        local horiz = WS:Raycast(currentPos, Vector3.new(dx, 0, dz), rayParams)
        if not horiz then
            local floorRay = WS:Raycast(Vector3.new(destX, currentY + 15, destZ), Vector3.new(0, -50, 0), rayParams)
            if floorRay then
                local newY = floorRay.Position.Y + 3.5
                if math.abs(newY - currentY) < 10 then
                    myRoot.CFrame = CFrame.new(destX, newY, destZ)
                    return true
                end
            end
        end
    end
    return false
end

local function bindDamage()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local lastHealth = hum.Health
    hum.HealthChanged:Connect(function(hp)
        if hp < lastHealth and DamageTP.Enabled and Bot.Enabled then
            task.spawn(doDamageTeleport)
        end
        lastHealth = hp
    end)
end

local function runBot()
    if not Bot.Enabled then return end
    local now = tick()

    if now - Bot.LastTitanCheck > 0.5 then
        Bot.LastTitanCheck = now
        Bot.IsTitan = isTitan()
    end

    local myRoot = getMyRoot()
    local hum = getMyHum()
    if not myRoot or not hum or hum.Health <= 0 then
        Bot.State = "DEAD"
        if Bot.IsHoldingLaser then
            local _, r = getWeapon()
            endLaser(r)
        end
        return
    end

    if Auto.ReviveEnabled then
        local downed = findDownedPlayer()
        if downed and not hasImmediateThreat(myRoot.Position, 30) then
            local dist = hDist(myRoot.Position, downed.pos)
            if dist > (downed.prompt.MaxActivationDistance or 10) * 0.8 then
                Bot.State = "REVIVE MOVE"
                hum:MoveTo(downed.pos)
                Bot.Waypoints = {}
                Bot.WaypointIndex = 1
                return
            else
                Bot.State = "REVIVING"
                triggerPrompt(downed.prompt)
                task.wait(0.15)
                return
            end
        end
    end

    if now - Bot.LastTargetScan > 0.5 then
        Bot.LastTargetScan = now
        if not isValidEnemy(Bot.Target) then
            Bot.Target = findNearestEnemy()
            Bot.Waypoints = {}
            Bot.WaypointIndex = 1
        end
    end

    if not isValidEnemy(Bot.Target) then
        Bot.Target = nil
        if Bot.IsHoldingLaser then
            local _, r = getWeapon()
            endLaser(r)
        end
        if now - Bot.LastActionTime > 2 then
            Bot.Target = findNearestEnemy()
            Bot.Waypoints = {}
            Bot.WaypointIndex = 1
        end
        if not Bot.Target then
            Bot.State = "NO TARGET"
            return
        end
    end

    local targetRoot = getRoot(Bot.Target)
    if not targetRoot then return end

    local hd = hDist(myRoot.Position, targetRoot.Position)

    if Bot.IsTitan then
        titanRush(hum, myRoot, targetRoot.Position)
        if hd <= Bot.KeepDistance + 10 then
            useAbility()
        end
    else
        humanKite(hum, myRoot, targetRoot.Position, now)
        if hd <= Bot.ShootRange then
            if not Bot.IsHoldingLaser then
                if now - Bot.LastShoot >= Bot.AttackInterval then
                    Bot.LastShoot = now
                    shootTarget(Bot.Target)
                end
            else
                if now - Bot.LaserStart > Bot.LaserHoldTime + 3 then
                    local _, r = getWeapon()
                    endLaser(r)
                end
            end
        end
    end

    if checkStuck(myRoot) then
        unstuck(hum, myRoot)
    end

    if now - Bot.LastActionTime > 8 then
        Bot.LastActionTime = now
        Bot.Target = nil
        Bot.Waypoints = {}
        Bot.WaypointIndex = 1
    end
end

RS.Heartbeat:Connect(function()
    pcall(runBot)
end)

local function findRemote(name)
    local ev = ReplicatedStorage:FindFirstChild("Events")
    if not ev then return nil end
    local r = ev:FindFirstChild(name)
    if r and r:IsA("RemoteEvent") then return r end
    return nil
end

