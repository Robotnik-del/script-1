local function Slider(name, min, max, default, decimals, cb)
    local sf = Instance.new("Frame")
    sf.Size = UDim2.new(1, 0, 0, isMobile and 48 or 40)
    sf.BackgroundColor3 = BG3
    sf.BorderSizePixel = 0
    sf.Parent = CA
    Instance.new("UICorner", sf).CornerRadius = UDim.new(0, 6)
    local sl = Instance.new("TextLabel")
    sl.Size = UDim2.new(1, -10, 0, 16)
    sl.Position = UDim2.new(0, 5, 0, 2)
    sl.BackgroundTransparency = 1
    sl.TextXAlignment = Enum.TextXAlignment.Left
    sl.TextColor3 = TXT
    sl.Font = Enum.Font.Gotham
    sl.TextSize = 9
    sl.Text = name .. ": " .. default
    sl.Parent = sf
    local sb = Instance.new("TextButton")
    sb.Size = UDim2.new(1, -10, 0, isMobile and 8 or 5)
    sb.Position = UDim2.new(0, 5, 0, isMobile and 26 or 22)
    sb.BackgroundColor3 = Color3.fromRGB(50, 60, 75)
    sb.BorderSizePixel = 0
    sb.Text = ""
    sb.AutoButtonColor = false
    sb.Parent = sf
    Instance.new("UICorner", sb).CornerRadius = UDim.new(1, 0)
    local sbf = Instance.new("Frame")
    sbf.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    sbf.BackgroundColor3 = HubC
    sbf.BorderSizePixel = 0
    sbf.Parent = sb
    Instance.new("UICorner", sbf).CornerRadius = UDim.new(1, 0)
    local dragging = false
    local function update(pct)
        local v = min + (max - min) * pct
        if decimals == 0 then
            v = math.floor(v)
        else
            v = math.floor(v * (10 ^ decimals)) / (10 ^ decimals)
        end
        sbf.Size = UDim2.new(pct, 0, 1, 0)
        sl.Text = name .. ": " .. v
        local fn = cb
        fn(v)
    end
    local function touchUpdate(input)
        local bp = sb.AbsolutePosition
        local bs = sb.AbsoluteSize
        update(math.clamp((input.Position.X - bp.X) / bs.X, 0, 1))
    end
    sb.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            PlaySound(SliderSound)
            dragging = true
            touchUpdate(input)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            touchUpdate(input)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

