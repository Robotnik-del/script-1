local function storeBaseSizes()
    for _, d in ipairs(Win:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and not d:GetAttribute("_baseSize") then
            d:SetAttribute("_baseSize", d.TextSize)
        end
    end
end

