local function getViewport()
    local cam = WS.CurrentCamera
    return cam and cam.ViewportSize or Vector2.new(800, 600)
end

local isMobile = UIS.TouchEnabled and not UIS.KeyboardEnabled

local function calcLayout()
    local vp = getViewport()
    local maxW = isMobile and 400 or 580
    local maxH = isMobile and 560 or 660
    local w = math.clamp(math.floor(vp.X * 0.88), 300, math.max(300, math.min(maxW, vp.X - 20)))
    local h = math.clamp(math.floor(vp.Y * 0.72), 360, math.max(360, math.min(maxH, vp.Y - 30)))
    local side = math.clamp(math.floor(w * 0.28), 88, 140)
    local scale = math.clamp(w / (isMobile and 360 or 460), 0.78, 1.15)
    return w, h, side, scale
end

