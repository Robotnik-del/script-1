local function applyResponsive()
    local w, h, side, scale = calcLayout()
    winW, winH, SideWidth, uiScale = w, h, side, scale

    Win.Size = UDim2.new(0, w, 0, h)
    if not userMoved then
        Win.Position = UDim2.new(0.5, -w / 2, 0.5, -h / 2)
    end

    if TabsFrame then
        TabsFrame.Size = UDim2.new(0, side, 1, -TB.Size.Y.Offset)
    end
    if CA then
        CA.Size = UDim2.new(1, -side, 1, -TB.Size.Y.Offset - 32)
        CA.Position = UDim2.new(0, side, 0, TB.Size.Y.Offset + 26)
    end

    for _, d in ipairs(Win:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            local base = d:GetAttribute("_baseSize")
            if base then
                d.TextSize = math.max(8, math.floor(base * scale))
            end
        end
    end

    NFs.Size = UDim2.new(0, math.min(280, w - 40), 0, 0)

    local vp = getViewport()
    if FloatBtn.Visible then
        local px = FloatBtn.Position.X.Offset
        local py = FloatBtn.Position.Y.Offset
        FloatBtn.Position = UDim2.new(0, math.clamp(px, 0, math.max(0, vp.X - 50)), 0, math.clamp(py, 0, math.max(0, vp.Y - 50)))
    end
end

