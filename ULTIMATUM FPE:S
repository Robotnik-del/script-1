                    if not U.Config.InfStamina.enabled then return end
                    local maxStam = stats:GetAttribute("MaxStamina") or 100
                    if stats:GetAttribute("Stamina") < maxStam then
                        stats:SetAttribute("Stamina", maxStam)
                    end
                end)
