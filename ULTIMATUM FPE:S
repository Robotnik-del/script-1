            end
        end
    end
    return closest
end
U.thavelPredictPosition = function(part)
    return part.Position + (part.AssemblyLinearVelocity or Vector3.zero) * U.getPing()
end
U.thavelGetAimCFrame = function()
    if not U.State.thavel.aimTarget then return nil end
    local part = U.thavelGetAimPartModel(U.State.thavel.aimTarget)
    if not part then return nil end
    local camera = U.getCamera()
    return CFrame.new(camera.CFrame.Position, U.thavelPredictPosition(part))
end
U.thavelExtractLookVector = function(lv)
    if not lv then return nil end
    if typeof(lv) == "CFrame" then return lv.LookVector
    elseif typeof(lv) == "Vector3" then return lv end
    return nil
end
U.thavelClearVisuals = function()
    for _, p in pairs(U.State.thavel.trajectoryParts) do pcall(function() p:Destroy() end) end
    for _, p in pairs(U.State.thavel.hitboxParts) do pcall(function() p:Destroy() end) end
    U.State.thavel.trajectoryParts = {}
    U.State.thavel.hitboxParts = {}
end
U.thavelDrawTrajectory = function(thavel)
    U.thavelClearVisuals()
    if not U.Config.ThavelAimbot.showTrajectory or not thavel then return end
    local root = thavel:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local lookVector = U.thavelExtractLookVector(thavel:GetAttribute("PounceLookVector"))
    if not lookVector or lookVector.Magnitude < 0.01 then return end
    local startPos = root.Position
    local direction = lookVector.Unit
    local chargeSpeed, hitboxSize = 100, Vector3.new(6, 8, 11.5)
    if U.ThavelInfo and U.ThavelInfo.Movesets and U.ThavelInfo.Movesets.Pounce then
        chargeSpeed = U.ThavelInfo.Movesets.Pounce.ChargeSpeed or chargeSpeed
        hitboxSize = U.ThavelInfo.Movesets.Pounce.HitboxSize or hitboxSize
    end
    local maxTime = 1.5
    local totalLength = math.min(chargeSpeed * maxTime, U.Config.ThavelAimbot.maxDistance)
    local line = Instance.new("Part")
    line.Name = "ThavelTrajectory"
    line.Size = Vector3.new(0.4, 0.4, totalLength)
    line.Anchored = true
    line.CanCollide = false
    line.CanQuery = false
    line.CanTouch = false
    line.Material = Enum.Material.Neon
    line.Color = U.Config.ThavelAimbot.trajectoryColor
    line.Transparency = 0.2
    line.CFrame = CFrame.new(startPos, startPos + direction) * CFrame.new(0, 0, -totalLength / 2)
    line.Parent = workspace
    table.insert(U.State.thavel.trajectoryParts, line)
    if U.Config.ThavelAimbot.showHitbox then
        for i = 1, 6 do
            local t = (i / 6) * maxTime
            local pos = startPos + direction * (chargeSpeed * t)
            local hb = Instance.new("Part")
            hb.Name = "ThavelHitboxPreview"
            hb.Size = hitboxSize
            hb.Anchored = true
            hb.CanCollide = false
            hb.CanQuery = false
            hb.CanTouch = false
            hb.Material = Enum.Material.ForceField
            hb.Color = U.Config.ThavelAimbot.hitboxColor
            hb.Transparency = 0.85
            hb.CFrame = CFrame.new(pos) * CFrame.new(0, 0, hitboxSize.Z * -0.375)
            hb.Parent = workspace
            table.insert(U.State.thavel.hitboxParts, hb)
        end
    end
end
U.thavelAimAtTarget = function(target)
    if not target then return end
    local part = U.thavelGetAimPartModel(target)
    if not part then return end
    local camera = U.getCamera()
    local targetPos = U.thavelPredictPosition(part)
    local currentPos = camera.CFrame.Position
    if U.Config.ThavelAimbot.aimSmoothness >= 1 then
        camera.CFrame = CFrame.new(currentPos, targetPos)
    else
        local newLook = camera.CFrame.LookVector:Lerp((targetPos - currentPos).Unit, U.Config.ThavelAimbot.aimSmoothness)
        camera.CFrame = CFrame.new(currentPos, currentPos + newLook)
    end
end
U.thavelGetThavel = function()
    local f = workspace:FindFirstChild("Teachers")
    if f then
        for _, m in ipairs(f:GetChildren()) do
            if m:IsA("Model") and m:GetAttribute("TeacherName") == "Thavel" then
                local h = m:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then return m end
            end
        end
    end
    return nil
end
U.thavelInstallHook = function()
    if U.State.thavel.hookInstalled then return end
    if not U.Config.ThavelAimbot.hookEnabled then return end
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        if not mt then error("no mt") end
        local old = mt.__namecall
        if not old then error("no nc") end
        U.State.thavel.originalNamecall = old
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "FireServer" and U.State.thavel.aimTarget and U.Config.ThavelAimbot.aimbot and U.thavelIsOurs() then
                local args = {...}
                local modified = false
                for i, a in ipairs(args) do
                    if typeof(a) == "CFrame" then
                        local aimCF = U.thavelGetAimCFrame()
                        if aimCF then args[i] = aimCF; modified = true end
                    end
                end
                if modified then return old(self, unpack(args)) end
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end)
    if ok then U.State.thavel.hookInstalled = true
    else
        pcall(function()
            if not hookmetamethod then error("no hm") end
            local old
            old = hookmetamethod(game, "__namecall", function(self, ...)
                if getnamecallmethod() == "FireServer" and U.State.thavel.aimTarget and U.Config.ThavelAimbot.aimbot and U.thavelIsOurs() then
                    local args = {...}
                    local modified = false
                    for i, a in ipairs(args) do
                        if typeof(a) == "CFrame" then
                            local aimCF = U.thavelGetAimCFrame()
                            if aimCF then args[i] = aimCF; modified = true end
                        end
                    end
                    if modified then return old(self, unpack(args)) end
                end
                return old(self, ...)
            end)
            U.State.thavel.originalNamecall = old
            U.State.thavel.hookInstalled = true
        end)
    end
end
U.thavelUninstallHook = function()
    if not U.State.thavel.hookInstalled or not U.State.thavel.originalNamecall then return end
    pcall(function()
        local mt = getrawmetatable(game)
        if mt then
            setreadonly(mt, false)
            mt.__namecall = U.State.thavel.originalNamecall
            setreadonly(mt, true)
        end
    end)
    U.State.thavel.hookInstalled = false
end
U.thavelUpdatePounce:On(function(active, parent, lookVector)
    if not U.State.thavel.enabled or U.State.thavel.unloaded then return end
