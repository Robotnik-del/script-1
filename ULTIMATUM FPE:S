U.RunService.Heartbeat:Connect(function(dt)
    if U.Config.ESP.enabled then
        local now = os.clock()
        if now - U.State.espScan >= 0.5 then
            U.State.espScan = now
            U.scanPlayers()
            U.scanNPCs()
        end
        if now - U.State.espUpdate >= U.Config.ESP.updateInterval then
            U.State.espUpdate = now
            for plr, data in pairs(U.State.espData) do U.updateESPData(data, plr) end
        end
    end
    if U.Config.SmartSpeed.enabled then
        if U.detectRevert() then
            U.State.smartSpeed.targetSpeed = U.State.smartSpeed.lastBase
            U.State.smartSpeed.currentSpeed = U.State.smartSpeed.lastBase
        else
            U.State.smartSpeed.targetSpeed = U.computeTargetSpeed()
        end
        local diff = U.State.smartSpeed.targetSpeed - U.State.smartSpeed.currentSpeed
        if math.abs(diff) < 0.5 then U.State.smartSpeed.currentSpeed = U.State.smartSpeed.targetSpeed
        else
            local step = U.Config.SmartSpeed.smoothStep * dt * 10
            if diff > 0 then U.State.smartSpeed.currentSpeed = math.min(U.State.smartSpeed.currentSpeed + step, U.State.smartSpeed.targetSpeed)
            else U.State.smartSpeed.currentSpeed = math.max(U.State.smartSpeed.currentSpeed - step, U.State.smartSpeed.targetSpeed) end
        end
        local now = os.clock()
        if now - U.State.smartSpeedTick >= 0.05 then
            U.State.smartSpeedTick = now
            local hum = U.getHum()
            if hum then
                local base = U.getBaseSpeed()
                if U.State.smartSpeed.currentSpeed > base + 0.5 then
                    if hum.WalkSpeed ~= U.State.smartSpeed.currentSpeed then hum.WalkSpeed = U.State.smartSpeed.currentSpeed end
                else
                    if hum.WalkSpeed ~= base then hum.WalkSpeed = base end
                end
            end
        end
    end
    if U.Config.AntiStun.enabled then
        U.clearStunAttrs(); U.clearMoveLocks(); U.clearHumanoidStates(); U.forceWalkSpeed()
    end
    if U.Config.DoorNoclip.enabled then
        local now = os.clock()
        if now - U.State.doorNoclip.lastScan >= U.Config.DoorNoclip.rescanInterval then
            U.State.doorNoclip.lastScan = now
            U.scanAllDoors()
        end
    end
end)

U.RunService.RenderStepped:Connect(function()
    if not U.Config.Aim.enabled then return end
    local char = U.getChar()
    if not char then U.State.aimTarget = nil; U.State.aimTargetPart = nil; return end
    if U.Config.Aim.onlyWhenAiming and char:GetAttribute("Aiming") ~= true then U.State.aimTarget = nil; U.State.aimTargetPart = nil; return end
    local target = U.findBloomieAimTarget()
    U.State.aimTarget = target
    if target then
        local part = U.getAimPartModel(target, U.Config.Aim.aimPart)
        U.State.aimTargetPart = part
        if part then
            local camera = U.getCamera()
            local targetPos = U.predictPosition(part)
            local currentPos = camera.CFrame.Position
            if U.Config.Aim.snapStrength >= 1 then
                camera.CFrame = CFrame.new(currentPos, targetPos)
            else
                local newLook = camera.CFrame.LookVector:Lerp((targetPos - currentPos).Unit, U.Config.Aim.snapStrength)
                camera.CFrame = CFrame.new(currentPos, currentPos + newLook)
            end
        end
    else
        U.State.aimTargetPart = nil
    end
end)

