    local now = os.clock()
    if now - U.State.lastBlock < U.Config.AutoBlock.cooldown then return end
    local char = U.getChar()
    if not char then return end
    if char:GetAttribute("Stunned") or char:GetAttribute("Ragdolled") then return end
    U.State.lastBlock = now
    U.State.blockCount = U.State.blockCount + 1
    pcall(function()
        local events = require(U.RS:WaitForChild("Network"):WaitForChild("Events"))
        events.BlockRequest:Client():Fire()
    end)
