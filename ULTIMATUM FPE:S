U.getOurTeamName = function()
    local char = U.getChar()
    if not char then return nil end
    if workspace:FindFirstChild("Students") and char:IsDescendantOf(workspace.Students) then return "Students" end
    if workspace:FindFirstChild("Alices") and char:IsDescendantOf(workspace.Alices) then return "Alices" end
    if workspace:FindFirstChild("Teachers") and char:IsDescendantOf(workspace.Teachers) then return "Teachers" end
    local tn = char:GetAttribute("TeacherName")
    if tn == "Alice" or tn == "AlicePhase2" then return "Alices" end
    if tn and tn ~= "" then return "Teachers" end
    return "Students"
end
