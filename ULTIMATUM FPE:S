U.antiProjPredictClosest = function(projPos, projVel, myPos)
    local relPos = myPos - projPos
    local relVel = projVel
    if relVel.Magnitude < 0.1 then return nil end
    local timeToClosest = relPos:Dot(relVel) / (relVel.Magnitude ^ 2)
    if timeToClosest < 0 then return nil end
    local closestPos = projPos + relVel * timeToClosest
    local closestDist = (closestPos - myPos).Magnitude
    return timeToClosest, closestDist, closestPos
end
U.antiProjFindSafeSpot = function(myRoot, projectileVel, projectilePos)
    if not myRoot then return nil end
    local myPos = myRoot.Position
    local flatVel = Vector3.new(projectileVel.X, 0, projectileVel.Z)
    if flatVel.Magnitude < 0.1 then flatVel = Vector3.new(1, 0, 0) end
    flatVel = flatVel.Unit
    local side = flatVel:Cross(Vector3.new(0, 1, 0))
    if side.Magnitude < 0.1 then side = Vector3.new(1, 0, 0) end
    side = side.Unit
    local d = U.Config.AntiProj.dodgeDistance
    local candidates
    if U.Config.AntiProj.perpendicularOnly then
        candidates = {
            myPos + side * d, myPos - side * d,
            myPos + side * d + Vector3.new(0, 2, 0), myPos - side * d + Vector3.new(0, 2, 0),
            myPos + side * (d * 1.5), myPos - side * (d * 1.5),
            myPos + side * d * 0.75 + flatVel * (d * 0.4),
            myPos - side * d * 0.75 + flatVel * (d * 0.4),
        }
    else
        candidates = {
            myPos + side * d, myPos - side * d,
            myPos + side * d - flatVel * (d * 0.5), myPos - side * d - flatVel * (d * 0.5),
            myPos + side * (d * 1.2), myPos - side * (d * 1.2),
            myPos - flatVel * d,
            myPos + side * d + Vector3.new(0, 3, 0), myPos - side * d + Vector3.new(0, 3, 0),
        }
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { U.getChar() }
    for _, candidate in ipairs(candidates) do
        local dir = candidate - myPos
        local dist = dir.Magnitude
        if dist > 0.1 then
            local newDistToProj = projectilePos and (candidate - projectilePos).Magnitude or math.huge
            local oldDistToProj = projectilePos and (myPos - projectilePos).Magnitude or math.huge
            local isSafe = true
            if U.Config.AntiProj.perpendicularOnly and newDistToProj < oldDistToProj then isSafe = false end
            if isSafe then
                local hit = workspace:Raycast(myPos, dir.Unit * dist, params)
                if not hit then
                    local downHit = workspace:Raycast(candidate, Vector3.new(0, -30, 0), params)
                    if downHit then return candidate end
                end
            end
        end
    end
    return nil
end
U.antiProjDoDodge = function(proj)
    local now = os.clock()
    if now - U.State.antiProj.lastDodge < U.Config.AntiProj.dodgeCooldown then return false end
    local myRoot = U.getRoot()
    if not myRoot then return false end
    local safeSpot = U.antiProjFindSafeSpot(myRoot, proj.Velocity or Vector3.new(1, 0, 0), proj.Position)
    if not safeSpot then
        local flatVel = Vector3.new((proj.Velocity or Vector3.new(1, 0, 0)).X, 0, (proj.Velocity or Vector3.new(1, 0, 0)).Z)
        if flatVel.Magnitude < 0.1 then flatVel = Vector3.new(1, 0, 0) end
        local fallbackSide = flatVel.Unit:Cross(Vector3.new(0, 1, 0))
        if fallbackSide.Magnitude < 0.1 then fallbackSide = Vector3.new(1, 0, 0) end
        safeSpot = myRoot.Position + fallbackSide.Unit * U.Config.AntiProj.dodgeDistance
    end
    U.State.antiProj.lastDodge = now
    U.State.antiProj.dodgeCount = U.State.antiProj.dodgeCount + 1
    U.State.antiProj.dodgedIds[proj.Id] = now
    local savedVel = myRoot.AssemblyLinearVelocity
    myRoot.CFrame = CFrame.new(safeSpot, safeSpot + myRoot.CFrame.LookVector)
    myRoot.AssemblyLinearVelocity = savedVel
    return true
end
U.replicateBlade:On(function(action, ...)
    if not U.State.antiProj.enabled or U.State.antiProj.unloaded then return end
    if action == "Create" or action == true then
        local arg = ...
        local list = {}
        if type(arg) == "table" then
            if arg.Id then table.insert(list, arg)
            else
                for _, p in ipairs(arg) do
                    if type(p) == "table" and p.Id then table.insert(list, p) end
                end
            end
        end
        for _, p in ipairs(list) do
            if p.Owner ~= U.LP.Name and p.Owner ~= U.LP then
                local proj = {
                    Id = p.Id, Owner = p.Owner,
                    Position = p.CurrentPos or p.Position,
                    Velocity = p.Velocity, Weight = p.Weight or 0,
                    Type = p.Type, Skin = p.Skin,
                    Lifetime = p.Lifetime or 5,
                    SentTime = p.SentTime or workspace:GetServerTimeNow(),
                    SpawnTime = os.clock(),
                }
                U.State.antiProj.projectiles[p.Id] = proj
            end
        end
    elseif action == "Destroy" then
        local id = ...
        U.State.antiProj.projectiles[id] = nil
    end
end)
U.antiProjUpdateConn = U.RunService.Heartbeat:Connect(function()
    if not U.State.antiProj.enabled or U.State.antiProj.unloaded then return end
    local myRoot = U.getRoot()
    if not myRoot then return end
    local myPos = myRoot.Position
    local now = os.clock()
    local ping = U.getPing()
    for id, proj in pairs(U.State.antiProj.projectiles) do
        local elapsed = now - proj.SpawnTime
        if elapsed > proj.Lifetime + 1 then
            U.State.antiProj.projectiles[id] = nil
        else
            local serverElapsed = workspace:GetServerTimeNow() - proj.SentTime
            local gravity = Vector3.new(0, -1, 0) * proj.Weight
            local realPos = proj.Position + proj.Velocity * serverElapsed + gravity * 0.5 * serverElapsed * serverElapsed
            local currentVel = proj.Velocity + gravity * serverElapsed
            if U.Config.AntiProj.autoDodge then
                local lastDodged = U.State.antiProj.dodgedIds[id]
                if not lastDodged or now - lastDodged > 1.5 then
                    local predictedPos = realPos + currentVel * ping
                    local t, dist = U.antiProjPredictClosest(predictedPos, currentVel, myPos)
                    if t and t > 0 and t < U.Config.AntiProj.dodgeTime and dist < U.Config.AntiProj.hitRadius then
                        U.antiProjDoDodge(proj)
                    end
                end
            end
        end
    end
end)
U.State.antiProj.connections.update = U.antiProjUpdateConn

