U.getNearestChaser = function()
    local root = U.getRoot()
    if not root then return nil, math.huge end
    local closest, closestDist = nil, math.huge
    for _, t in ipairs(U.getTeachers()) do
        local tr = t:FindFirstChild("HumanoidRootPart")
        if tr then
            local d = (tr.Position - root.Position).Magnitude
            if d < closestDist and d < U.Config.SmartSpeed.detectRange then
                closestDist = d
                closest = t
            end
        end
    end
    return closest, closestDist
end
U.getTeacherSpeed = function(teacher)
    if not teacher then return 16 end
    if teacher:GetAttribute("Stunned") then return 16 end
    local root = teacher:FindFirstChild("HumanoidRootPart")
    if root then
        local vel = root.AssemblyLinearVelocity or Vector3.zero
        local spd = Vector3.new(vel.X, 0, vel.Z).Magnitude
        if spd > 1 then return spd end
    end
    local attr = teacher:GetAttribute("RunSpeed")
    if attr and typeof(attr) == "number" then return attr end
    local h = teacher:FindFirstChildOfClass("Humanoid")
    return h and h.WalkSpeed or 16
end
U.getProximityFactor = function(dist)
    if dist >= U.Config.SmartSpeed.mediumRange then return 0 end
    if dist <= U.Config.SmartSpeed.closeRange then return 1 end
    return (U.Config.SmartSpeed.mediumRange - dist) / (U.Config.SmartSpeed.mediumRange - U.Config.SmartSpeed.closeRange)
end
U.getApproachFactor = function(teacher)
    local root = U.getRoot()
    local tr = teacher and teacher:FindFirstChild("HumanoidRootPart")
    if not root or not tr then return 0 end
    local vel = tr.AssemblyLinearVelocity or Vector3.zero
    local toMe = (root.Position - tr.Position)
    if toMe.Magnitude < 0.1 then return 0 end
    toMe = toMe.Unit
    local velDir = Vector3.new(vel.X, 0, vel.Z)
    if velDir.Magnitude < 1 then return 0 end
    velDir = velDir.Unit
    local dot = velDir:Dot(toMe)
    if dot <= 0 then return 0 end
    return math.min(dot, 1)
end
U.getSprintFactor = function(teacher)
    if not teacher then return 0 end
    if teacher:GetAttribute("Running") == true then return 1 end
    local tr = teacher:FindFirstChild("HumanoidRootPart")
    if tr then
        local vel = tr.AssemblyLinearVelocity or Vector3.zero
        local spd = Vector3.new(vel.X, 0, vel.Z).Magnitude
        if spd > 20 then return 1 end
        if spd > 12 then return 0.5 end
    end
    return 0
end
U.getThreatFactor = function(teacher)
    if not teacher then return 0 end
    for _, a in ipairs({"Charging","ChargingGrab","UsingSpikes","Teleporting","Attacking","PounceHit","Enraged"}) do
        if teacher:GetAttribute(a) == true then return 1 end
    end
    if teacher:GetAttribute("Instinct") == true then return 1 end
    return 0
end
U.getBaseSpeed = function()
    local char = U.getChar()
    if not char then return 16 end
    local dw = char:GetAttribute("DefaultWalk") or 16
    local rs = char:GetAttribute("RunSpeed") or 26
    U.State.smartSpeed.baseWalk = dw
    U.State.smartSpeed.baseRun = rs
    if char:GetAttribute("Running") then return rs else return dw end
end
U.computeTargetSpeed = function()
    local char = U.getChar()
    if not char then return 16 end
    local isRunning = char:GetAttribute("Running")
    local base = isRunning and U.State.smartSpeed.baseRun or U.State.smartSpeed.baseWalk
    U.State.smartSpeed.lastBase = base
    if not U.Config.SmartSpeed.enabled then return base end
    if U.Config.SmartSpeed.skipIfTeacher and U.isOurTeacher() then return base end
    local ping = U.getPing()
    if ping > 0.4 then return base end
    local chaser, dist = U.getNearestChaser()
    if not chaser then
        U.State.smartSpeed.threatMode = false
        return base
    end
    local bonusMult = isRunning and U.Config.SmartSpeed.runBonus or U.Config.SmartSpeed.walkBonus
    local prox = U.getProximityFactor(dist)
    local approach = U.getApproachFactor(chaser)
    local sprint = U.getSprintFactor(chaser)
    local threat = U.getThreatFactor(chaser)
    U.State.smartSpeed.threatMode = threat > 0
    local totalMult = bonusMult
        + U.Config.SmartSpeed.proximityBonus * prox
        + U.Config.SmartSpeed.approachBonus * approach
        + U.Config.SmartSpeed.sprintBonus * sprint
        + U.Config.SmartSpeed.threatBonus * threat
    local chaserSpeed = U.getTeacherSpeed(chaser)
    local speed = math.max(base, chaserSpeed) * totalMult
    local maxSpeed = isRunning and U.Config.SmartSpeed.maxRunSpeed or U.Config.SmartSpeed.maxWalkSpeed
    return math.min(speed, maxSpeed)
end
U.detectRevert = function()
    local root = U.getRoot()
    if not root then return false end
    local now = os.clock()
    if now - U.State.smartSpeed.lastCheckTime < 0.2 then return false end
    if U.State.smartSpeed.lastPos then
        local dist = (root.Position - U.State.smartSpeed.lastPos).Magnitude
        local dt = now - U.State.smartSpeed.lastCheckTime
        local expected = U.State.smartSpeed.lastBase * dt
        if dist > expected * 4 and dist > 25 then
            U.State.smartSpeed.reverts = U.State.smartSpeed.reverts + 1
            return true
        end
    end
    U.State.smartSpeed.lastPos = root.Position
    U.State.smartSpeed.lastCheckTime = now
    return false
end
U.WALL_PARENT_KEYWORDS = {"map","environment","building","wall","floor","ceiling","room","corridor","world","level","structure","arena"}
U.WALL_IGNORE_KEYWORDS = {"hitbox","effect","particle","ability","step","stair","decal","texture","trail","smoke","vfx","vignette","hair","hat","accessory","blocked","sfx","sound","candy","candies","prop","detail","glass","window"}
U.isRealWall = function(object)
    if not object then return false end
    if object:IsA("Terrain") then return true end
    local nl = object.Name:lower()
    for _, ig in ipairs(U.WALL_IGNORE_KEYWORDS) do if nl:find(ig,1,true) then return false end end
    local parent = object.Parent
    while parent and parent ~= workspace do
        local pN = parent.Name:lower()
        for _, kw in ipairs(U.WALL_PARENT_KEYWORDS) do if pN:find(kw,1,true) then return true end end
        parent = parent.Parent
    end
    if object:IsA("BasePart") and object.Anchored and not object:IsDescendantOf(U.Players) then
        local size = object.Size
        if size.X*size.Y*size.Z > 200 and math.min(size.X,size.Y,size.Z) > 2 then return true end
    end
    return false
end
U.buildWallFilter = function()
    local list = { U.getChar(), U.LP.Character }
    for _, fName in ipairs({"Teachers","Alices","Students"}) do
        local f = workspace:FindFirstChild(fName)
        if f then table.insert(list, f) end
