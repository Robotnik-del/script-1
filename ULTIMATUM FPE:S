U.playAnimation = function(animId, loop, speed)
    local hum = U.getHum()
    if not hum or not animId or animId == "" then return end
    U.stopAnimation()
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    local id = tostring(animId)
    if id:match("^%d+$") then
        id = "rbxassetid://" .. id
    elseif not id:match("rbxassetid") and not id:match("^http") then
        id = "rbxassetid://" .. id
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = id
    local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
    if not ok or not track then return end
    track.Priority = Enum.AnimationPriority.Action4
    pcall(function() track.Looped = loop end)
    local played = pcall(function() track:Play(0.1) end)
    if not played then return end
    pcall(function() track:AdjustSpeed(speed) end)
    U.State.currentTrack = track
    U.State.animPlaying = true
    local t = track
    U.State.animTrackStoppedConn = t.Stopped:Connect(function()
        if U.State.currentTrack == t then
            U.State.currentTrack = nil
            U.State.animPlaying = false
            if U.State.animTrackStoppedConn then
                pcall(function() U.State.animTrackStoppedConn:Disconnect() end)
                U.State.animTrackStoppedConn = nil
            end
        end
    end)
end
