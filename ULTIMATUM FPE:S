U.Players.PlayerRemoving:Connect(function(p)
    local d = U.State.espData[p]
    if d then U.destroyESP(d); U.State.espData[p] = nil end
    U.State.devCache[p] = nil
    U.State.panicCache[p] = nil
    U.State.aimVelocityCache[p] = nil
end)

U.LP.CharacterAdded:Connect(function()
    task.wait(0.5)
    U.cleanupESP()
    U.stopAnimation()
    if U.Config.SmartSpeed.enabled then
        U.State.smartSpeed.currentSpeed = 16
        U.State.smartSpeed.targetSpeed = 16
    end
