U.getGroupRank = function(plr)
    if not plr then return nil end
    local ok, result = pcall(function()
        return U.GroupService:GetRolesInGroupAsync(plr.UserId, U.GROUP_ID)
    end)
    if not ok or not result or not result.IsMember then return nil end
    local highest, highestName = 0, nil
    for _, role in ipairs(result.Roles) do
        if role.Rank > highest then highest = role.Rank; highestName = role.Name end
    end
    if highest > 0 then return highest, highestName end
    return nil
end
U.getDevInfo = function(plr)
    if not plr then return nil end
    if U.State.devCache[plr] ~= nil then return U.State.devCache[plr] or nil end
    local rank, roleName = U.getGroupRank(plr)
    if not rank then U.State.devCache[plr] = false; return nil end
    local info = U.DevRanks[rank] or {rank=rank,name=roleName or "Member",color=Color3.fromRGB(100,100,255)}
    U.State.devCache[plr] = info
    return info
end
U.checkPanicLeave = function(plr)
    if not U.Config.Panic.enabled then return end
    if plr == U.LP then return end
    if U.State.panicCache[plr] ~= nil then
        if U.State.panicCache[plr] then U.LP:Kick(U.Config.Panic.message) end
        return
    end
    local rank = U.getGroupRank(plr)
    local should = rank ~= nil and U.Config.Panic.ranks[rank] == true
    U.State.panicCache[plr] = should
    if should then U.LP:Kick(U.Config.Panic.message) end
end
U.getColorForPlayer = function(p)
    local char = p.Character
    local tn = char and char:GetAttribute("TeacherName")
    if tn == "Alice" or tn == "AlicePhase2" then return Color3.fromRGB(180,0,255) end
    if tn and tn ~= "" then return Color3.fromRGB(255,60,60) end
    local dev = U.getDevInfo(p)
    if dev then return dev.color end
    if U.SpecialPlayers[tostring(p.UserId)] then return Color3.fromRGB(0,255,200) end
    if U.Config.ESP.teamCheck then
        if U.getTeam(U.LP) == U.getTeam(p) then return U.Config.ESP.playerColor
        else return U.Config.ESP.enemyColor end
    end
    if p:GetAttribute("HasVIP") then return Color3.fromRGB(255,220,0) end
    return U.Config.ESP.playerColor
end
