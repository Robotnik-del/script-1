U.vhFire = function(targetModel)
    if U.vh.running or not U.Config.VelocityHitbox.enabled then return end
    local hrp = U.getRoot()
    if not hrp or not hrp.Parent then return end
    if not targetModel then targetModel = U.vhFindNearest() end
    if not targetModel then return end
    local targetHrp = U.vhGetTargetRoot(targetModel)
    if not targetHrp then return end
    local startDelta = targetHrp.Position - hrp.Position
    if startDelta.Magnitude <= U.Config.VelocityHitbox.stopDist then return end
    U.vh.running = true
    local startPos = hrp.Position
    local startTime = tick()
    local savedVel = hrp.AssemblyLinearVelocity
    if U.Config.VelocityHitbox.hideSelf then U.vhHideSelf() end
    task.spawn(function()
        if U.Config.VelocityHitbox.mode == "Forward" then
            local look = hrp.CFrame.LookVector
            look = Vector3.new(look.X, 0, look.Z)
            if look.Magnitude < 0.01 then look = Vector3.new(0, 0, -1) end
            look = look.Unit
            local shake = Vector3.new(
                (math.random()-0.5) * 2 * U.Config.VelocityHitbox.shake, 0,
                (math.random()-0.5) * 2 * U.Config.VelocityHitbox.shake
            )
            local dir = (look + shake * 0.02).Unit
            if U.Config.VelocityHitbox.useLinearVelocity then
                U.vhCreateLunge(hrp, dir, U.Config.VelocityHitbox.speed)
                task.wait(U.Config.VelocityHitbox.duration)
                U.vhRemoveLunge()
            else
                hrp.AssemblyLinearVelocity = dir * U.Config.VelocityHitbox.speed + shake * 0.5
                task.wait(U.Config.VelocityHitbox.duration)
                if hrp and hrp.Parent then hrp.AssemblyLinearVelocity = savedVel end
            end
            U.vh.running = false
            if U.Config.VelocityHitbox.hideSelf then U.vhShowSelf() end
            return
        end
        if U.Config.VelocityHitbox.mode == "Magnetic" then
            local currentTargetHrp = targetHrp
            while tick() - startTime < U.Config.VelocityHitbox.duration do
                if not U.Config.VelocityHitbox.enabled then break end
                if not hrp or not hrp.Parent then break end
                if not currentTargetHrp or not currentTargetHrp.Parent then
                    local newT = U.vhFindNearest()
                    if newT then currentTargetHrp = U.vhGetTargetRoot(newT) end
                    if not currentTargetHrp or not currentTargetHrp.Parent then break end
                end
                local elapsed = tick() - startTime
                local delta = currentTargetHrp.Position - hrp.Position
                local distTo = delta.Magnitude
                if distTo <= U.Config.VelocityHitbox.stopDist then break end
                local traveled = (hrp.Position - startPos).Magnitude
                if traveled >= U.Config.VelocityHitbox.maxTravel then break end
                local horiz = Vector3.new(delta.X, 0, delta.Z)
                if horiz.Magnitude > 0.1 then
                    horiz = horiz.Unit
                    local speedFactor = math.clamp(1 - (elapsed / U.Config.VelocityHitbox.duration), 0, 1)
                    speedFactor = speedFactor * speedFactor
                    local speed = (U.Config.VelocityHitbox.speed + distTo * 1.5) * speedFactor
                    local stepCap = math.max((U.Config.VelocityHitbox.maxTravel - traveled) * 12, 5)
                    hrp.AssemblyLinearVelocity = horiz * math.min(speed, stepCap)
                end
                U.RunService.Heartbeat:Wait()
            end
            if hrp and hrp.Parent then hrp.AssemblyLinearVelocity = savedVel end
            U.vh.running = false
            if U.Config.VelocityHitbox.hideSelf then U.vhShowSelf() end
            return
        end
        if U.Config.VelocityHitbox.mode == "Impulse" then
            local look = hrp.CFrame.LookVector
            look = Vector3.new(look.X, 0, look.Z).Unit
            local shake = Vector3.new(
                (math.random()-0.5) * 2 * U.Config.VelocityHitbox.shake,
                (math.random()-0.5) * U.Config.VelocityHitbox.shake,
                (math.random()-0.5) * 2 * U.Config.VelocityHitbox.shake
            )
            hrp.AssemblyLinearVelocity = look * U.Config.VelocityHitbox.speed + shake
            task.wait(U.Config.VelocityHitbox.duration)
            if hrp and hrp.Parent then hrp.AssemblyLinearVelocity = savedVel end
            U.vh.running = false
            if U.Config.VelocityHitbox.hideSelf then U.vhShowSelf() end
            return
        end
    end)
end
U.vhInstallHeartbeat = function()
    if U.vh.heartbeatConn then return end
    U.vh.heartbeatConn = U.RunService.Heartbeat:Connect(function()
        if not U.Config.VelocityHitbox.enabled or U.vh.running then return end
        if not U.Config.VelocityHitbox.autoOnSwing then return end
        local char = U.getChar()
        local hrp = U.getRoot()
        if not char or not hrp or not hrp.Parent then return end
        if not U.vhIsSwinging() then U.vh.swingFired = false; return end
        if U.vh.swingFired then return end
        if tick() - U.vh.lastSwingTime < U.Config.VelocityHitbox.cooldown then return end
        local target = U.vhFindNearest()
        if target then
            U.vh.swingFired = true
            U.vh.lastSwingTime = tick()
            U.vhFire(target)
        end
    end)
end
U.vhInstallInput = function()
    if U.vh.inputConn then return end
    U.vh.inputConn = U.UIS.InputBegan:Connect(function(input, processed)
        if processed then return end
        if not U.Config.VelocityHitbox.enabled then return end
        if input.KeyCode == U.Config.VelocityHitbox.manualKey then U.vhFire() end
    end)
    if U.vh.mouseConn then return end
    U.vh.mouseConn = U.UIS.InputBegan:Connect(function(input, processed)
        if processed then return end
        if not U.Config.VelocityHitbox.enabled then return end
        if not U.Config.VelocityHitbox.autoOnSwing then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if U.vh.running then return end
        if tick() - U.vh.lastSwingTime < U.Config.VelocityHitbox.cooldown then return end
        local target = U.vhFindNearest()
        if target then
            U.vh.swingFired = true
            U.vh.lastSwingTime = tick()
            U.vhFire(target)
        end
    end)
end
U.vhStart = function() U.vhInstallHeartbeat(); U.vhInstallInput() end
U.vhStop = function()
    if U.vh.heartbeatConn then pcall(function() U.vh.heartbeatConn:Disconnect() end); U.vh.heartbeatConn = nil end
    if U.vh.inputConn then pcall(function() U.vh.inputConn:Disconnect() end); U.vh.inputConn = nil end
    if U.vh.mouseConn then pcall(function() U.vh.mouseConn:Disconnect() end); U.vh.mouseConn = nil end
