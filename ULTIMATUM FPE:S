U.isWallBetween = function(fromPos, toPos)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = U.buildWallFilter()
    params.IgnoreWater = true
    local dir = toPos - fromPos
    if dir.Magnitude < 0.1 then return false end
    local result = workspace:Raycast(fromPos, dir, params)
    if not result then return false end
    return U.isRealWall(result.Instance)
end
U.isInRange = function(myRoot, teacherRoot)
    local ping = U.getPing()
    if ping > 0.5 then return false end
    local pred = teacherRoot.Position + (teacherRoot.AssemblyLinearVelocity or Vector3.zero) * (ping * 2)
    local diff = pred - myRoot.Position
    if Vector3.new(diff.X, 0, diff.Z).Magnitude > U.Config.AutoBlock.radius then return false end
    if math.abs(diff.Y) > U.Config.AutoBlock.radiusY then return false end
    return true
end
U.isFacingMe = function(teacherRoot, myRoot)
    if not U.Config.AutoBlock.checkFacing then return true end
    local toMe = (myRoot.Position - teacherRoot.Position)
    if toMe.Magnitude < 0.1 then return true end
    return teacherRoot.CFrame.LookVector:Dot(toMe.Unit) >= U.Config.AutoBlock.facingDot
end
U.doBlock = function()
