U.processQuestion = function(qf)
    if not qf or not qf:IsA("Frame") then return end
    if qf.Name == "Template" then return end
    if not qf.Name:match("^Question") then return end
    if qf:GetAttribute("HLDoneQ") then return end
    local qt = qf:FindFirstChild("QuestionText")
    if not qt or not qt:IsA("TextLabel") then return end
    local bl = qf:FindFirstChild("ButtonList")
    if not bl then return end
    local correct = U.getCorrectAnswer(qt.Text)
    if not correct then return end
    local correctNorm = U.normalizeText(correct)
    qf:SetAttribute("HLDoneQ", true)
    task.spawn(function()
        for _ = 1, 8 do
            if not U.Config.Notebook.enabled then return end
            for _, ch in ipairs(bl:GetChildren()) do
                if ch:IsA("TextButton") and ch.Visible then
                    local bn = U.normalizeText(ch.Text)
                    if bn ~= "" and (bn == correctNorm or bn:find(correctNorm, 1, true)) then
                        U.highlightNotebook(ch)
                        return
                    end
                end
            end
            task.wait(0.25)
        end
        qf:SetAttribute("HLDoneQ", false)
    end)
end
