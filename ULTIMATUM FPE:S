U.destroyESP = function(data)
    if not data then return end
    pcall(function() if data.highlight then data.highlight:Destroy() end end)
    pcall(function() if data.billboard then data.billboard:Destroy() end end)
end
U.updateESPData = function(data, plr)
    if not data or not data.billboard or not data.billboard.Parent then return end
    local now = os.clock()
    if now - data.lastUpdate < U.Config.ESP.updateInterval then return end
    data.lastUpdate = now
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local currentHead = char:FindFirstChild("Head") or hrp
    if data.head ~= currentHead then
        data.head = currentHead
        data.billboard.Adornee = currentHead
    end
    local myHrp = U.getRoot()
    local dist = myHrp and math.floor((hrp.Position - myHrp.Position).Magnitude) or 0
    if data.infoLabel then
        if U.Config.ESP.showDistance or U.Config.ESP.showHealth then
            local parts = {}
            if U.Config.ESP.showDistance then parts[#parts + 1] = dist .. "m" end
            if U.Config.ESP.showHealth then parts[#parts + 1] = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) end
            data.infoLabel.Text = table.concat(parts, " | ")
            data.infoLabel.Visible = true
            data.infoLabel.TextColor3 = U.getColorForPlayer(plr)
        else
            data.infoLabel.Text = ""
            data.infoLabel.Visible = false
        end
    end
    if data.nameLabel then
        if U.Config.ESP.showNames then
            local tn = char:GetAttribute("TeacherName")
            local dev = U.getDevInfo(plr)
            local special = U.SpecialPlayers[tostring(plr.UserId)]
            local prefix = ""
            if tn and tn ~= "" then
                prefix = tn == "Alice" and "[Δlice] " or ("[" .. tn .. "] ")
            elseif dev then prefix = "[" .. dev.name .. "] "
            elseif special then prefix = "[" .. special .. "] "
            end
            if plr:GetAttribute("HasVIP") then prefix = prefix .. "[VIP] " end
            data.nameLabel.Text = prefix .. plr.DisplayName .. " (@" .. plr.Name .. ")"
            data.nameLabel.TextColor3 = U.getColorForPlayer(plr)
            data.nameLabel.Visible = true
        else
            data.nameLabel.Text = ""
            data.nameLabel.Visible = false
        end
    end
end
U.scanPlayers = function()
    if not U.Config.ESP.enabled or not U.Config.ESP.showPlayers then
        for plr, data in pairs(U.State.espData) do
            U.destroyESP(data)
            U.State.espData[plr] = nil
        end
        return
    end
    local seen = {}
    for _, plr in ipairs(U.Players:GetPlayers()) do
        if plr ~= U.LP and U.isAlive(plr) then
            seen[plr] = true
            local char = plr.Character
            if char then
                local existing = U.State.espData[plr]
                local needsRecreate = false
                if not existing then needsRecreate = true
                elseif existing.target ~= char then needsRecreate = true
                elseif not existing.highlight or not existing.highlight.Parent then needsRecreate = true
                elseif not existing.billboard or not existing.billboard.Parent then needsRecreate = true end
                if needsRecreate then
                    if existing then U.destroyESP(existing) end
                    U.State.espData[plr] = U.createESP(char, U.getColorForPlayer(plr), plr.Name, false)
                else
                    local color = U.getColorForPlayer(plr)
                    existing.highlight.FillColor = color
                    existing.highlight.OutlineColor = color
                end
            end
        end
    end
    for plr, data in pairs(U.State.espData) do
        if not seen[plr] or not U.isAlive(plr) then
            U.destroyESP(data)
            U.State.espData[plr] = nil
        end
    end
end
U.scanNPCs = function()
    if not U.Config.ESP.enabled or not U.Config.ESP.showNPCs then
        for _, data in pairs(U.State.npcData) do U.destroyESP(data) end
        U.State.npcData = {}
        return
    end
    local seen = {}
    for _, folderName in ipairs({"Teachers", "Alices"}) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then
            for _, npc in ipairs(folder:GetChildren()) do
                if npc:IsA("Model") and not seen[npc] then
                    local h = npc:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then
                        seen[npc] = true
                        local existing = U.State.npcData[npc]
                        local needsRecreate = false
                        if not existing then needsRecreate = true
                        elseif not existing.highlight or not existing.highlight.Parent then needsRecreate = true
                        elseif not existing.billboard or not existing.billboard.Parent then needsRecreate = true end
                        if needsRecreate then
                            if existing then U.destroyESP(existing) end
                            local color = folderName == "Alices" and U.Config.ESP.aliceColor or U.Config.ESP.npcColor
                            U.State.npcData[npc] = U.createESP(npc, color, npc.Name, true)
                        end
                    end
                end
            end
        end
    end
    for npc, data in pairs(U.State.npcData) do
        if not seen[npc] or not npc.Parent then
            U.destroyESP(data)
            U.State.npcData[npc] = nil
        end
    end
end
U.cleanupESP = function()
    for _, d in pairs(U.State.espData) do U.destroyESP(d) end
    for _, d in pairs(U.State.npcData) do U.destroyESP(d) end
    U.State.espData = {}
    U.State.npcData = {}
end
