U.startHitboxLoop = function()
    if U.State.hitboxLoopConn then return end
    U.State.hitboxLoopConn = U.RunService.Heartbeat:Connect(function()
        for _, plr in ipairs(U.Players:GetPlayers()) do
            if plr ~= U.LP and plr.Character then
                local char = plr.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not U.Config.Hitbox.enabled then
                        U.resetHitbox(char)
                    elseif U.Config.Hitbox.teamCheck and plr.Team == U.LP.Team then
                        U.resetHitbox(char)
                    else
                        hrp.Size = Vector3.new(U.Config.Hitbox.size, U.Config.Hitbox.size, U.Config.Hitbox.size)
                        hrp.Color = U.Config.Hitbox.color
