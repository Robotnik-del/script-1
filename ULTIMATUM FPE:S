U.AttackAnimIds = {}
pcall(function()
    local Animations = require(U.RS.Shared.Animations)
    local function collect(node, path)
        if typeof(node) ~= "table" then return end
        for k, v in pairs(node) do
            if typeof(v) == "string" and (k == "Swing1" or k == "Swing2" or k:lower():find("attack")) then
                U.AttackAnimIds[v] = path .. "." .. tostring(k)
            elseif typeof(v) == "table" then
                collect(v, path .. "." .. tostring(k))
            end
        end
    end
    pcall(function() collect(Animations.Teacher, "Teacher") end)
end)

