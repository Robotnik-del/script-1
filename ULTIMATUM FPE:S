U.vhGetTargetRoot = function(model)
    if not model then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    return (hum and hum.RootPart) or model:FindFirstChild("HumanoidRootPart"), hum
end
U.vhIsSameTeam = function(model)
    if model == U.getChar() then return true end
    local char = U.getChar()
    if not char then return false end
    for _, name in ipairs({"Teachers","Students","Alices"}) do
        local f = workspace:FindFirstChild(name)
        if f and char:IsDescendantOf(f) and model:IsDescendantOf(f) then return true end
    end
    return false
end
U.vhCollectCandidates = function()
    local list, seen = {}, {}
    local function add(model)
        if not model or seen[model] or not model:IsA("Model") then return end
        if model == U.getChar() then return end
        local hrp, hum = U.vhGetTargetRoot(model)
        if not hrp or not hum or hum.Health <= 0 then return end
        if U.vhIsSameTeam(model) then return end
        seen[model] = true
        table.insert(list, model)
    end
    for _, plr in ipairs(U.Players:GetPlayers()) do
        if plr ~= U.LP and plr.Character then add(plr.Character) end
    end
    for _, folder in ipairs(U.getEnemyFolders()) do
        for _, m in ipairs(folder:GetChildren()) do add(m) end
    end
    if #list == 0 then
        for _, m in ipairs(workspace:GetChildren()) do
            if m:IsA("Model") then add(m)
            elseif m:IsA("Folder") then
                for _, c in ipairs(m:GetChildren()) do
                    if c:IsA("Model") then add(c) end
                end
            end
        end
    end
    return list
end
U.vhFindNearest = function()
    local hrp = U.getRoot()
    if not hrp then return nil end
    local myPos = hrp.Position
    local look = hrp.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude < 0.01 then look = Vector3.new(0, 0, -1) end
    look = look.Unit
    local best, bestDist = nil, math.huge
    for _, model in ipairs(U.vhCollectCandidates()) do
        local targetHrp = U.vhGetTargetRoot(model)
        if targetHrp then
            local delta = targetHrp.Position - myPos
            local dist = delta.Magnitude
            if dist <= U.Config.VelocityHitbox.range then
                local dir = Vector3.new(delta.X, 0, delta.Z)
                if dir.Magnitude > 0.01 then
                    dir = dir.Unit
                    local angle = math.deg(math.acos(math.clamp(look:Dot(dir), -1, 1)))
                    if angle <= U.Config.VelocityHitbox.fov / 2 and dist < bestDist then
                        bestDist = dist
                        best = model
                    end
                end
            end
        end
    end
    return best, bestDist
end
U.vhIsSwinging = function()
    local char = U.getChar()
    if not char then return false end
    if char:GetAttribute("Attacking") == true or char:GetAttribute("Swinging") == true then return true end
    local hum = U.getHum()
    local animator = (hum and hum:FindFirstChildOfClass("Animator")) or char:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            local name = (track.Animation and track.Animation.Name) or ""
            local l = name:lower()
            if l:find("swing") or l:find("attack") or l:find("slash") or l:find("m1") then return true end
        end
    end
    for _, s in ipairs(char:GetDescendants()) do
        if s:IsA("Sound") and s.Playing then
            local l = s.Name:lower()
            if l:find("swing") or l:find("slash") then return true end
        end
    end
    return false
end
U.vhHideSelf = function()
