U.handleThreat = function(teacher)
    local myRoot = U.getRoot()
    if not myRoot or not teacher then return end
    local tRoot = teacher:FindFirstChild("HumanoidRootPart")
    if not tRoot then return end
    if not U.isInRange(myRoot, tRoot) then return end
    if not U.isFacingMe(tRoot, myRoot) then return end
    if U.Config.AutoBlock.wallCheck then
        local dir = tRoot.Position - myRoot.Position
        local ro = myRoot.Position + Vector3.new(0, 1.5, 0)
        local unit = dir.Unit
        if U.isWallBetween(ro, ro + unit * dir.Magnitude) then return end
    end
    if U.Config.AutoBlock.chargeMode == "start" then
        U.doBlock()
    else
        local prev = U.State.chargeTimers[teacher]
        if prev then pcall(function() task.cancel(prev) end) end
        U.State.chargeTimers[teacher] = task.delay(U.Config.AutoBlock.chargeDelay, function()
            if not U.Config.AutoBlock.enabled then return end
            if not teacher.Parent then return end
            local tRN = teacher:FindFirstChild("HumanoidRootPart")
            local mRN = U.getRoot()
            if not tRN or not mRN then return end
            if not U.isInRange(mRN, tRN) then return end
            if not U.isFacingMe(tRN, mRN) then return end
            U.doBlock()
        end)
    end
end
