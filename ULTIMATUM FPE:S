U.tiCanSeeUs = function(teacherModel, myRoot)
    if not teacherModel or not myRoot then return false end
    local head = teacherModel:FindFirstChild("Head") or teacherModel:FindFirstChild("HumanoidRootPart")
    local tRoot = teacherModel:FindFirstChild("HumanoidRootPart")
    if not head or not tRoot then return false end
    local toUs = myRoot.Position - head.Position
    if toUs.Magnitude < 0.1 then return true end
    local facing = tRoot.CFrame.LookVector
    local flatTo = Vector3.new(toUs.X, 0, toUs.Z)
    if flatTo.Magnitude < 0.1 then return true end
    flatTo = flatTo.Unit
    local flatFacing = Vector3.new(facing.X, 0, facing.Z)
    if flatFacing.Magnitude < 0.1 then return false end
    flatFacing = flatFacing.Unit
    if flatFacing:Dot(flatTo) < 0.2 then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {teacherModel, U.getChar()}
    params.IgnoreWater = true
    local result = workspace:Raycast(head.Position, toUs, params)
    if not result then return true end
    if result.Instance:IsDescendantOf(U.getChar()) then return true end
    return false
end
U.tiUpdate = function()
    if not U.ti.enabled then return end
    local sg = U.tiEnsureGui()
    if not sg then return end
    local camera = U.getCamera()
    if not camera then return end
    local myRoot = U.getRoot()
    if not myRoot then return end
    local viewport = camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local radius = U.ti.radius
    local cameraLook = camera.CFrame.LookVector
    local cameraRight = camera.CFrame.RightVector
    local seen = {}
    for _, folderName in ipairs({"Teachers","Alices"}) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then
            for _, model in ipairs(folder:GetChildren()) do
                if model:IsA("Model") and model ~= U.LP.Character and not seen[model] then
                    local h = model:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
                        if hrp then
                            seen[model] = true
                            local cat = U.tiGetCategory(model)
                            local data = U.ti.indicators[model]
                            if not data or data.category ~= cat then
                                if data and data.icon then data.icon:Destroy() end
                                local container, img, distLbl, seenLbl = U.tiMakeIcon(cat)
                                if container then
                                    container.Parent = sg
                                    data = { icon = container, image = img, distLabel = distLbl, seenLabel = seenLbl, category = cat }
                                    U.ti.indicators[model] = data
                                else
                                    U.ti.indicators[model] = nil
                                    data = nil
                                end
                            end
                            if data and data.icon then
                                local toT = hrp.Position - camera.CFrame.Position
                                if toT.Magnitude > 0.1 then
                                    local dist = toT.Magnitude
                                    local unit = toT.Unit
                                    local angle = math.atan2(unit:Dot(cameraRight), unit:Dot(cameraLook))
                                    local baseSize = U.ti.iconSize
                                    local sz = baseSize
                                    if U.Config.TeacherIndicator.scaleByDistance then
                                        sz = math.clamp(baseSize * (1.2 - dist / 300), baseSize * 0.6, baseSize * 1.3)
                                    end
                                    local x = math.sin(angle) * radius
                                    local y = -math.cos(angle) * radius
                                    data.icon.Size = UDim2.new(0, sz, 0, sz + 18)
                                    data.icon.Position = UDim2.new(0, center.X + x - sz / 2, 0, center.Y + y - sz / 2)
                                    local w = sz
                                    if data.image then data.image.Size = UDim2.new(1, 0, 0, w) end
                                    if data.distLabel then
                                        if U.Config.TeacherIndicator.showDistance then
                                            data.distLabel.Position = UDim2.new(0, 0, 0, w)
                                            data.distLabel.Text = string.format("%dm", math.floor(dist))
                                            data.distLabel.Visible = true
                                        else
                                            data.distLabel.Visible = false
                                        end
                                    end
                                    if data.seenLabel then
                                        if U.Config.TeacherIndicator.showVisibility then
                                            local canSee = U.tiCanSeeUs(model, myRoot)
                                            if canSee then
                                                data.seenLabel.Position = UDim2.new(0, 0, 0, w + 12)
                                                data.seenLabel.Text = "SEEN"
                                                data.seenLabel.Visible = true
                                                if data.image then data.image.ImageColor3 = Color3.fromRGB(255, 80, 80) end
                                            else
                                                data.seenLabel.Text = ""
                                                data.seenLabel.Visible = false
                                                if data.image then data.image.ImageColor3 = Color3.fromRGB(255, 255, 255) end
                                            end
                                        else
                                            data.seenLabel.Visible = false
                                            if data.image then data.image.ImageColor3 = Color3.fromRGB(255, 255, 255) end
                                        end
                                    end
                                    data.icon.Visible = true
                                else
                                    data.icon.Visible = false
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    for model, data in pairs(U.ti.indicators) do
        if not seen[model] or not model.Parent then
            if data.icon then data.icon:Destroy() end
            U.ti.indicators[model] = nil
        end
    end
end
