U.m1AimHasLineOfSight = function(fromPos, targetPart)
    if not U.Config.M1Aim.wallCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {U.getChar(), targetPart.Parent, targetPart}
    local result = workspace:Raycast(fromPos, targetPart.Position - fromPos, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(targetPart.Parent)
end
U.m1AimFindTarget = function()
    local root = U.getRoot()
    if not root then return nil end
    local myPos = root.Position
    local folders = U.getEnemyFolders()
    if #folders == 0 then return nil end
    local best, bestDist = nil, U.Config.M1Aim.maxDistance
    for _, folder in ipairs(folders) do
        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model") and model ~= U.getChar() then
                local h = model:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    local part = model:FindFirstChild(U.Config.M1Aim.aimPart) or model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
                    if part then
                        local d = (part.Position - myPos).Magnitude
                        if d < bestDist and U.m1AimHasLineOfSight(myPos, part) then
                            bestDist = d
                            best = part
                        end
                    end
                end
            end
        end
    end
    return best
end
U.m1AimTick = function()
    if not U.Config.M1Aim.enabled then return end
    if not U.isOurTeacher() then return end
    local char = U.getChar()
    if not char then return end
    if U.Config.M1Aim.onlyWhileM1 then
        local recentlyTriggered = U.State.m1Aim.lastTurn and os.clock() - U.State.m1Aim.lastTurn <= 0.15
        local swinging = char:GetAttribute("Attacking") == true or char:GetAttribute("Swinging") == true
        if not swinging and not recentlyTriggered then return end
    end
    local root = U.getRoot()
    if not root then return end
    local target = U.m1AimFindTarget()
    if not target then return end
    U.State.m1Aim.target = target
    U.State.m1Aim.lastTurn = os.clock()
    local fromPos = root.Position
    local lookAt = Vector3.new(target.Position.X, fromPos.Y, target.Position.Z)
    if (lookAt - fromPos).Magnitude < 0.1 then return end
    if U.Config.M1Aim.snap then
        root.CFrame = CFrame.new(fromPos, lookAt)
    else
        local newLook = root.CFrame.LookVector:Lerp((lookAt - fromPos).Unit, 0.35)
        root.CFrame = CFrame.new(fromPos, fromPos + newLook)
    end
end
U.m1AimSetEnabled = function(v)
    U.Config.M1Aim.enabled = v
    if v then
        if not U.State.m1Aim.conn then
            U.State.m1Aim.conn = U.RunService.RenderStepped:Connect(function() pcall(U.m1AimTick) end)
        end
        if not U.State.m1Aim.inputConn then
            U.State.m1Aim.inputConn = U.UIS.InputBegan:Connect(function(input, gpe)
                if gpe or not U.Config.M1Aim.enabled then return end
                if not U.isOurTeacher() then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    U.State.m1Aim.lastTurn = os.clock()
                end
            end)
        end
    else
        if U.State.m1Aim.conn then pcall(function() U.State.m1Aim.conn:Disconnect() end); U.State.m1Aim.conn = nil end
        if U.State.m1Aim.inputConn then pcall(function() U.State.m1Aim.inputConn:Disconnect() end); U.State.m1Aim.inputConn = nil end
    end
end

