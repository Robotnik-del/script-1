U.thavelFindAimTarget = function()
    local camera = U.getCamera()
    local closest, closestScore = nil, math.huge
    for _, model in ipairs(U.collectTeacherAimModels()) do
        local part = U.thavelGetAimPartModel(model)
        if part then
            local dist = (part.Position - camera.CFrame.Position).Magnitude
            if dist <= U.Config.ThavelAimbot.maxDistance then
                local _, onScreen = camera:WorldToScreenPoint(part.Position)
